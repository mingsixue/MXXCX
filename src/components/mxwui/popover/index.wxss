sform:translate(0,-100%) rotate(0)}.mx-popover-bottom-right{transform:translate(0,100%);transform-origin:right top}.mx-popover-bottom-right-arrow{top:2rpx;right:24rpx;transform:translate(0,-100%) rotate(0)}.mx-popover-left-top{transform:translate(-100%,0);transform-origin:right top}.mx-popover-left-top-arrow{right:2rpx;top:24rpx;transform:translate(75%,0) rotate(90deg)}.mx-popover-left-bottom{transform:translate(-100%,0);transform-origin:right bottom}.mx-popover-left-bottom-arrow{right:2rpx;bottom:24rpx;transform:translate(75%,0) rotate(90deg)}.mx-popover-right-top{transform:translate(100%,0);transform-origin:left top}.mx-popover-right-top-arrow{left:2rpx;top:24rpx;transform:translate(-75%,0) rotate(-90deg)}.mx-popover-right-bottom{transform:translate(100%,0);transform-origin:left bottom}.mx-popover-right-bottom-arrow{left:2rpx;bottom:24rpx;transform:translate(-75%,0) rotate(-90deg)}