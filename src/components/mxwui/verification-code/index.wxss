.mx-verification-code .dialog-cons{margin-bottom:48rpx}.mx-verification-code .dialog-cons .infos{display:flex;align-items:center;justify-content:space-between;padding:40rpx}.mx-verification-code .dialog-cons .infos .left .txt{font-size:28rpx;color:#9aa0b1}.mx-verification-code .dialog-cons .infos .left .phone{margin-top:4rpx;font-size:32rpx;font-weight:700;color:#040a23}.mx-verification-code .dialog-cons .codes{position:relative;padding:0 40rpx}.mx-verification-code .dialog-cons .codes.codes-digit4{padding:0 100rpx}.mx-verification-code .dialog-cons .codes .codes-inner{display:flex;align-items:center;justify-content:space-between}.mx-verification-code .dialog-cons .codes .captcha-cell{position:relative;display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:4rpx;background:#f4f6f7;border:2rpx solid #f4f6f7;color:#040a23;font-size:56rpx;font-weight:700;margin-right:26rpx;box-sizing:content-box}.mx-verification-code .dialog-cons .codes .captcha-cell:last-child{margin-right:0}.mx-verification-code .dialog-cons .codes .captcha-cell .captcha-digit{line-height:1}.mx-verification-code .dialog-cons .codes .captcha-cell .captcha-caret{width:4rpx;height:48rpx;border-radius:2rpx;animation:captchaCaretBlink 1s steps(1) infinite}.mx-verification-code .dialog-cons .codes .captcha-hidden-input{position:absolute;left:-9999px;top:0;width:40px;height:40px;opacity:0;z-index:1;color:transparent;caret-color:transparent;pointer-events:none}.mx-verification-code .form-input{flex-grow:1;height:92rpx;font-size:32rpx;color:#040a23}.mx-verification-code .desc{padding:12rpx 24rpx 24rpx;font-size:24rpx;line-height:40rpx;color:#656979}@keyframes captchaCaretBlink{0%,50%{opacity:1}100%,50.01%{opacity:0}}