.mxbtn{display:flex;align-items:center;justify-content:center;height:88rpx;border-radius:4rpx;box-sizing:border-box;font-size:36rpx;font-family:PingFangSC-Semibold,PingFang SC;padding:0;width:702rpx}.mxbtn.mxbtn-primary{color:#fff;background:#292b2f}.mxbtn.mxbtn-primary.mxbtn-hover{background:rgba(41,43,47,.8)}.mxbtn.mxbtn-primary.mxbtn-unClick{color:rgba(255,255,255,.5);background:rgba(41,43,47,.5)}.mxbtn.mxbtn-primary.mxbtn-disabled{background:#9aa0b1}.mxbtn.mxbtn-ghost{color:#292b2f;border:2rpx solid #292b2f;background:0 0}.mxbtn.mxbtn-ghost.mxbtn-hover{color:rgba(41,43,47,.8);border-color:rgba(41,43,47,.7)}.mxbtn.mxbtn-ghost.mxbtn-unClick{color:rgba(41,43,47,.4);border-color:rgba(41,43,47,.4)}.mxbtn.mxbtn-ghost.mxbtn-disabled{color:#9aa0b1;border-color:#9aa0b1}.mxbtn.mxbtn-default{color:#292b2f;border:2rpx solid #292b2f;background:rgba(41,43,47,.05)}.mxbtn.mxbtn-default.mxbtn-hover{color:rgba(41,43,47,.8);background:rgba(41,43,47,.03)}.mxbtn.mxbtn-default.mxbtn-unClick{color:rgba(41,43,47,.4);border-color:rgba(41,43,47,.4)}.mxbtn.mxbtn-default.mxbtn-disabled{color:#9aa0b1;border-color:#9aa0b1;background:rgba(154,160,177,.05)}.mxbtn.mxbtn-round{border-radius:44rpx}.mxbtn.mxbtn-small{height:56rpx;font-size:28rpx}