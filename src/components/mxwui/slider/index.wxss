.mx-slider{width:100%;-webkit-user-select:none;-moz-user-select:none;user-select:none}.mx-slider.mx-slider-disabled{opacity:.45;pointer-events:none}.mx-slider .mx-slider-track{position:relative;width:100%;height:56rpx}.mx-slider .mx-slider-track.mx-slider-track-number{height:100rpx}.mx-slider .mx-slider-touch{position:absolute;left:28rpx;right:28rpx;top:0;height:100%}.mx-slider .mx-slider-rail{position:absolute;left:0;right:0;top:25rpx;height:6rpx;border-radius:3rpx;background:#eff0f5}.mx-slider .mx-slider-fill{position:absolute;top:25rpx;height:6rpx;border-radius:3rpx;background:#ca0e2d}.mx-slider .mx-slider-tick{position:absolute;top:28rpx;width:16rpx;height:16rpx;margin-left:-8rpx;border-radius:50%;background:#eff0f5;transform:translateY(-50%);z-index:1}.mx-slider .mx-slider-tick.mx-slider-tick-active{background:#ca0e2d}.mx-slider .mx-slider-tick-number{position:absolute;top:28rpx;left:50%;transform:translateX(-50%);color:#040a23;font-size:24rpx;line-height:32rpx;white-space:nowrap}.mx-slider .mx-slider-handler{position:absolute;top:28rpx;z-index:2;transform:translate(-50%,-50%);touch-action:none}.mx-slider .mx-slider-handler-block{position:relative;width:56rpx;height:56rpx;border-radius:50%;background:#fff;box-shadow:0 4rpx 12rpx rgba(0,0,0,.12)}.mx-slider .mx-slider-handler-icon{position:absolute;top:0;left:0;right:0;bottom:0}.mx-slider .mx-slider-handler-icon .line{position:absolute;width:4rpx;border-radius:2rpx;background:#ca0e2d}.mx-slider .mx-slider-handler-icon .line1{height:16rpx;top:20rpx;left:16rpx}.mx-slider .mx-slider-handler-icon .line2{height:24rpx;top:16rpx;left:26rpx}.mx-slider .mx-slider-handler-icon .line3{height:16rpx;top:20rpx;right:16rpx}.mx-slider .mx-slider-tooltip{position:absolute;left:50%;bottom:calc(100% + 12rpx);transform:translateX(-50%);min-width:48rpx;padding:6rpx 12rpx;border-radius:8rpx;background:rgba(4,10,35,.75);color:#fff;font-size:22rpx;line-height:30rpx;text-align:center;white-space:nowrap;pointer-events:none}.mx-slider .mx-slider-tooltip::after{content:'';position:absolute;left:50%;top:100%;margin-left:-6rpx;border:6rpx solid transparent;border-top-color:rgba(4,10,35,.75)}