<view class="mx-slider {{disabled ? 'mx-slider-disabled' : ''}}"><view class="mx-slider-track {{showNumber ? 'mx-slider-track-number' : ''}}"><view class="mx-slider-touch" id="{{trackId}}" catchtouchstart="handleTouchStart" catchtouchmove="handleTouchMove" catchtouchend="handleTouchEnd" catchtouchcancel="handleTouchEnd" ><view class="mx-slider-rail" style="background: {{inactiveColor}};"></view><view class="mx-slider-fill" style="left: {{sliderLeft}}%; width: {{sliderWidth}}%; background: {{activeColor}}; {{activeLineStyle}}" ></view><block wx:if="{{showTicks}}"><view class="mx-slider-tick {{item.active ? 'mx-slider-tick-active' : ''}}" wx:for="{{tickList}}" wx:key="value" style="left: {{item.left}}%; background: {{item.active ? activeColor : inactiveColor}}; {{item.active ? activeDotStyle : ''}}" ><view class="mx-slider-tick-number" wx:if="{{showNumber}}">{{item.value}}</view></view></block><view class="mx-slider-handler" wx:if="{{range}}" style="left: {{sliderLeft}}%;" ><view class="mx-slider-tooltip" wx:if="{{showTooltip && changingStart}}">{{tipStart}}</view><view class="mx-slider-handler-block" style="background: {{handleColor}};"><view class="mx-slider-handler-icon"><view class="line line1" style="background: {{activeColor}};"></view><view class="line line2" style="background: {{activeColor}};"></view><view class="line line3" style="background: {{activeColor}};"></view></view></view></view><view class="mx-slider-handler" style="left: {{handlerRight}}%;"><view class="mx-slider-tooltip" wx:if="{{showTooltip && changingEnd}}">{{tipEnd}}</view><view class="mx-slider-handler-block" style="background: {{handleColor}};"><view class="mx-slider-handler-icon"><view class="line line1" style="background: {{activeColor}};"></view><view class="line line2" style="background: {{activeColor}};"></view><view class="line line3" style="background: {{activeColor}};"></view></view></view></view></view></view></view> 