<view class="mx-footer" style="{{customStyle}}"><view wx:if="{{label && !noLabelDivider}}" class="mx-footer-label"><mx-divider text="{{label}}" textColor="#9AA0B1" textSize="{{28}}" lineColor="#E1E5EC" customStyle="padding:20rpx 0;" /></view><view wx:elif="{{label}}" class="mx-footer-label mx-footer-label-plain"><text class="mx-footer-label-text">{{label}}</text></view><slot wx:else name="label"></slot><view wx:if="{{links.length}}" class="mx-footer-links"><block wx:for="{{links}}" wx:key="key"><view class="mx-footer-links-item {{item.disabled ? 'disabled' : ''}}" data-item="{{item}}" data-index="{{index}}" hover-class="{{item.disabled ? '' : 'mx-footer-hover'}}" hover-start-time="20" hover-stay-time="50" bind:tap="handleLinkTap" ><text class="mx-footer-links-text">{{item.text}}</text></view><mx-divider wx:if="{{index !== links.length - 1}}" direction="vertical" lineColor="#E1E5EC" customStyle="height:24rpx;margin:0 16rpx;" /></block></view><view wx:if="{{content}}" class="mx-footer-content"><text>{{content}}</text></view><slot wx:else name="content"></slot><view wx:if="{{chips.length}}" class="mx-footer-chips"><view class="mx-footer-chips-item {{index === 0 ? 'first' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{chips}}" wx:key="key" data-item="{{item}}" data-index="{{index}}" hover-class="{{item.disabled ? '' : 'mx-footer-hover'}}" hover-start-time="20" hover-stay-time="50" bind:tap="handleChipTap" ><text>{{item.text}}</text></view></view></view> 