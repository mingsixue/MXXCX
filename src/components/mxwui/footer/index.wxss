.mx-footer{display:flex;flex-direction:column;align-items:center;box-sizing:border-box;width:100%;padding:16rpx 32rpx 32rpx}.mx-footer .mx-footer-hover{opacity:.4}.mx-footer .mx-footer-label{width:100%;margin:0;padding:0}.mx-footer .mx-footer-label-plain{display:flex;align-items:center;justify-content:center;margin:20rpx 0}.mx-footer .mx-footer-label-text{font-size:28rpx;line-height:40rpx;color:#9aa0b1}.mx-footer .mx-footer-label-slot{width:100%}.mx-footer .mx-footer-links{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:center;margin:8rpx 0}.mx-footer .mx-footer-links-item{display:flex;flex-direction:row;align-items:center}.mx-footer .mx-footer-links-item.disabled .mx-footer-links-text{color:#9aa0b1}.mx-footer .mx-footer-links-text{font-size:26rpx;line-height:37rpx;color:#1677ff}.mx-footer .mx-footer-content{margin:8rpx 0;font-size:26rpx;line-height:37rpx;color:#9aa0b1;text-align:center}.mx-footer .mx-footer-content-slot{width:100%}.mx-footer .mx-footer-chips{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:center;margin:12rpx 0}.mx-footer .mx-footer-chips-item{box-sizing:border-box;height:49rpx;margin-left:24rpx;padding:8rpx 24rpx;border-radius:25rpx;font-size:24rpx;line-height:33rpx;color:#1677ff;background:#eff0f5}.mx-footer .mx-footer-chips-item.first{margin-left:0}.mx-footer .mx-footer-chips-item.disabled{color:#9aa0b1;background:#f4f6f7}