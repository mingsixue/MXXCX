.mx-divider{box-sizing:border-box}.mx-divider.mx-divider-horizontal{display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;width:100%;padding:24rpx 0}.mx-divider .mx-divider-line{min-width:0;height:0;box-sizing:border-box}.mx-divider .mx-divider-text{flex:none;margin:0 24rpx;font-size:28rpx;line-height:1.4;color:#656979;white-space:nowrap}.mx-divider.mx-divider-vertical{display:inline-block;width:0;height:1em;margin:0 16rpx;padding:0;overflow:hidden;vertical-align:middle;line-height:1;font-size:28rpx;border-right:2rpx solid #e1e5ec}