 name="{{item._iconName}}" color="{{item.iconColor || COLOR.TEXT_COLOR}}" size="{{iconSize}}" /></view><view class="mx-grid-item-info"><view wx:if="{{item.title}}" class="mx-grid-item-title">{{item.title}}</view><view wx:if="{{item.description}}" class="mx-grid-item-description">{{item.description}}</view></view></view></view> 