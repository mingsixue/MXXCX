.mx-progress-bar{box-sizing:border-box}.mx-progress-bar.mx-progress-bar-line{display:flex;flex-direction:row;align-items:center;width:100%}.mx-progress-bar.mx-progress-bar-circle{position:relative;display:inline-block;vertical-align:top}.mx-progress-bar .mx-progress-bar-outer{flex:1;width:0;min-width:0;height:8px;overflow:hidden;border-radius:999px;background-color:#eff0f5}.mx-progress-bar .mx-progress-bar-inner{height:100%;border-radius:999px;background-color:#ca0e2d;transition:width .3s ease;position:relative}.mx-progress-bar .mx-progress-bar-inner.mx-progress-bar-inner-success{background-color:#098562}.mx-progress-bar .mx-progress-bar-inner.mx-progress-bar-inner-exception{background-color:#ca0e2d}.mx-progress-bar .mx-progress-bar-indicator{margin-left:16rpx;color:#656979;font-size:26rpx;line-height:1;display:flex;align-items:center;flex-shrink:0}.mx-progress-bar .mx-progress-bar-indicator-circle{margin-left:0;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1;font-size:32rpx;color:#040a23}.mx-progress-bar .mx-progress-bar-text{white-space:nowrap}.mx-progress-bar .mx-progress-bar-canvas{width:100%;height:100%;display:block}