<view class="mx-progress-bar mx-progress-bar-{{type}} {{status ? 'mx-progress-bar-' + status : ''}}" style="{{type === 'circle' ? circleWrapStyle : 'width:100%;'}}" ><view wx:if="{{type === 'line'}}" class="mx-progress-bar-outer" style="{{lineOuterStyle}}"><view class="mx-progress-bar-inner {{status === 'success' || status === 'exception' ? 'mx-progress-bar-inner-' + status : ''}}" style="{{lineBarStyle}}" ></view></view><view class="mx-progress-bar-indicator" wx:if="{{type === 'line' && showInfo}}"><mx-icon wx:if="{{statusIcon}}" name="{{statusIcon}}" color="{{statusIconColor}}" size="32" /><text wx:else class="mx-progress-bar-text">{{curProgress}}%</text></view><block wx:if="{{type === 'circle' && canvasId}}"><canvas class="mx-progress-bar-canvas" canvas-id="{{canvasId}}" width="{{canvasWidth}}" height="{{canvasWidth}}" style="width:{{canvasWidth}}px;height:{{canvasWidth}}px;" ></canvas><view class="mx-progress-bar-indicator mx-progress-bar-indicator-circle" wx:if="{{showInfo}}"><mx-icon wx:if="{{statusIcon}}" name="{{statusIcon}}" color="{{statusIconColor}}" size="40" /><text wx:else class="mx-progress-bar-text">{{curProgress}}%</text></view></block></view> 