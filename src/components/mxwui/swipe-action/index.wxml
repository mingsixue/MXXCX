<view class="mx-swipe-action {{disabled ? 'mx-swipe-action-disabled' : ''}} {{className}}" bind:touchstart="startDrag" capture-bind:touchmove="onDrag" bind:touchend="endDrag" bind:touchcancel="endDrag" catch:touchmove="{{catchMove ? 'noop' : ''}}" ><view class="mx-swipe-action-wrapper" style="{{wrapperStyle}}"><view wx:if="{{_leftButtons.length}}" class="mx-swipe-action-left" style="width: {{leftWidthRpx}}rpx;" ><view wx:for="{{_leftButtons}}" wx:for-index="idx" wx:key="idx" class="mx-swipe-action-btn mx-swipe-action-btn-{{item.type}} {{item.className}}" style="width: {{item.width}}rpx; background: {{item.bgColor}}; color: {{item.color}};" data-direction="left" data-index="{{idx}}" catch:tap="onButtonTap" ><text class="mx-swipe-action-btn-text">{{item.text}}</text></view></view><view class="mx-swipe-action-content" data-key="cell" bind:tap="onContentTap"><slot></slot></view><view wx:if="{{_rightButtons.length}}" class="mx-swipe-action-right" style="width: {{rightWidthRpx}}rpx;" ><view wx:for="{{_rightButtons}}" wx:for-index="idx" wx:key="idx" class="mx-swipe-action-btn mx-swipe-action-btn-{{item.type}} {{item.className}}" style="width: {{item.width}}rpx; background: {{item.bgColor}}; color: {{item.color}};" data-direction="right" data-index="{{idx}}" catch:tap="onButtonTap" ><text class="mx-swipe-action-btn-text">{{item.text}}</text></view></view></view></view> 