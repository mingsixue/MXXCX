.mx-swipe-action{position:relative;overflow:hidden;width:100%;box-sizing:border-box}.mx-swipe-action .mx-swipe-action-wrapper{position:relative}.mx-swipe-action .mx-swipe-action-left,.mx-swipe-action .mx-swipe-action-right{position:absolute;top:0;display:flex;flex-direction:row;align-items:stretch;height:100%}.mx-swipe-action .mx-swipe-action-left{left:0;transform:translate3d(-100%,0,0)}.mx-swipe-action .mx-swipe-action-right{right:0;transform:translate3d(100%,0,0)}.mx-swipe-action .mx-swipe-action-content{position:relative;width:100%;background:#fff;box-sizing:border-box}.mx-swipe-action .mx-swipe-action-btn{display:flex;flex-direction:row;align-items:center;justify-content:center;height:100%;box-sizing:border-box;padding:0 8rpx;font-size:28rpx;line-height:1.2;text-align:center;color:#fff;background:#c8c9cc}.mx-swipe-action .mx-swipe-action-btn.mx-swipe-action-btn-default{background:#c8c9cc}.mx-swipe-action .mx-swipe-action-btn.mx-swipe-action-btn-primary{background:#1677ff}.mx-swipe-action .mx-swipe-action-btn.mx-swipe-action-btn-danger{background:#ca0e2d}.mx-swipe-action .mx-swipe-action-btn-text{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-break:break-all}