.mx-dropdown{position:relative;display:inline-block}.mx-dropdown.mx-dropdown-with-mask{z-index:999}.mx-dropdown .mx-dropdown-children{position:relative;z-index:2;display:inline-block}.mx-dropdown .mx-dropdown-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:1;background:0 0}.mx-dropdown .mx-dropdown-menu{position:absolute;z-index:3;box-sizing:border-box;min-width:200rpx;max-width:calc(100vw - 48rpx)}.mx-dropdown .mx-dropdown-inner{position:relative;background:#fff;border-radius:16rpx;overflow:hidden;box-shadow:0 8rpx 28rpx rgba(4,10,35,.16);padding:8rpx 0;box-sizing:border-box;animation:mx-dropdown-in .2s ease}.mx-dropdown .mx-dropdown-item{display:flex;align-items:center;min-height:80rpx;padding:0 32rpx;box-sizing:border-box}.mx-dropdown .mx-dropdown-item:active:not(.mx-dropdown-item-disabled){background:#eff0f5}.mx-dropdown .mx-dropdown-item-disabled{opacity:.5}.mx-dropdown .mx-dropdown-item-divided{margin-top:8rpx;padding-top:8rpx;border-top:1rpx solid #e1e5ec}.mx-dropdown .mx-dropdown-item-icon{display:flex;align-items:center;justify-content:center;margin-right:16rpx;flex-shrink:0}.mx-dropdown .mx-dropdown-item-img{width:36rpx;height:36rpx;display:block}.mx-dropdown .mx-dropdown-item-text{flex:1;font-size:28rpx;line-height:40rpx;color:#040a23;word-break:break-all}.mx-dropdown-bottom{transform:translate(-50%,0);transform-origin:center top}.mx-dropdown-bottom-left{transform:translate(0,0);transform-origin:left top}.mx-dropdown-bottom-right{transform:translate(0,0);transform-origin:right top}.mx-dropdown-top{transform:translate(-50%,0);transform-origin:center bottom}.mx-dropdown-top-left{transform:translate(0,0);transform-origin:left bottom}.mx-dropdown-top-right{transform:translate(0,0);transform-origin:right bottom}@keyframes mx-dropdown-in{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}