<view id="mx-dropdown-root" class="mx-dropdown {{showMask && innerVisible ? 'mx-dropdown-with-mask' : ''}}" style="z-index:{{innerVisible ? zIndex : 'auto'}};" ><view id="mx-dropdown-children" class="mx-dropdown-children" catch:tap="handleTriggerTap" ><slot></slot></view><view wx:if="{{!destroyOnClose || innerVisible}}" hidden="{{!innerVisible}}" id="mx-dropdown-menu" class="mx-dropdown-menu mx-dropdown-{{adjustedPlacement}}" style="{{dropdownMenuStyle}};{{adjustedPlacement ? '' : 'opacity:0;'}}{{menuWidthStyle}}{{menuStyle}}" catch:tap="handleMenuTap" ><view class="mx-dropdown-inner"><block wx:if="{{options.length}}"><view wx:for="{{options}}" wx:key="index" class="mx-dropdown-item {{item.disabled ? 'mx-dropdown-item-disabled' : ''}} {{item.divided ? 'mx-dropdown-item-divided' : ''}}" catch:tap="handleItem" data-item="{{item}}" data-idx="{{index}}" ><view wx:if="{{item.iconName || item.iconUrl}}" class="mx-dropdown-item-icon"><image wx:if="{{item.iconUrl}}" class="mx-dropdown-item-img" mode="aspectFit" src="{{item.iconUrl}}" style="width:{{item.iconSize || 36}}rpx;height:{{item.iconSize || 36}}rpx;" /><mx-icon wx:else name="{{item.iconName}}" color="{{item.disabled ? PLACEHOLDER_COLOR : (item.iconColor || item.color || TEXT_COLOR)}}" size="{{item.iconSize || 36}}" /></view><view class="mx-dropdown-item-text" style="color:{{item.disabled ? PLACEHOLDER_COLOR : (item.color || TEXT_COLOR)}};" >{{item.text}}</view></view></block><slot wx:else name="menu"></slot></view></view><view wx:if="{{showMask && innerVisible}}" class="mx-dropdown-mask" catch:tap="handleMaskTap" ></view></view> 