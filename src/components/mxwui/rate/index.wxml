<view class="mx-rate {{readonly ? 'mx-rate-readonly' : ''}}" style="font-size: {{size}}rpx;"><view class="mx-rate-container" catchtouchstart="handleTouchStart" catchtouchmove="handleTouchMove" catchtouchend="handleTouchEnd" ><view class="mx-rate-star" wx:for="{{stars}}" wx:key="index" style="width: {{size}}rpx; height: {{size}}rpx; margin-right: {{gutter}}rpx;" ><view class="mx-rate-star-icon mx-rate-star-icon-void" style="color: {{voidColor}};"><text wx:if="{{character}}" class="mx-rate-char">{{character}}</text><mx-icon wx:else name="{{icon}}" color="{{voidColor}}" size="{{size}}" /></view><view class="mx-rate-star-clip" style="width: {{item.activeWidth}};" ><view class="mx-rate-star-icon mx-rate-star-icon-active" style="width: {{size}}rpx; height: {{size}}rpx; color: {{color}};"><text wx:if="{{character}}" class="mx-rate-char">{{character}}</text><mx-icon wx:else name="{{icon}}" color="{{color}}" size="{{size}}" /></view></view><view wx:if="{{!readonly}}" class="mx-rate-star-hit"><view wx:if="{{allowHalf}}" class="mx-rate-star-hit-half" data-value="{{item.halfValue}}" catch:tap="handleTap" /><view class="mx-rate-star-hit-full {{allowHalf ? 'mx-rate-star-hit-half-right' : ''}}" data-value="{{item.fullValue}}" catch:tap="handleTap" /></view></view></view></view> 