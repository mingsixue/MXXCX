.mx-loading{box-sizing:border-box}.mx-loading.mx-loading-small{width:35rpx;height:35rpx}.mx-loading.mx-loading-medium{width:70rpx;height:70rpx}.mx-loading.mx-loading-large{width:105rpx;height:105rpx}.mx-loading.mx-loading-x-large{width:140rpx;height:140rpx}.mx-loading.mx-loading-spin{display:inline-flex;justify-content:center;align-items:center;vertical-align:middle}.mx-loading .mx-loading-spin-icon{box-sizing:border-box;width:100%;height:100%;border-radius:50%;border-style:solid;border-width:3rpx;border-top-color:#ca0e2d;border-left-color:#ca0e2d;border-right-color:transparent;border-bottom-color:transparent;animation:mx-loading-rotate .8s linear infinite}.mx-loading.mx-loading-dot{position:relative;display:inline-block;vertical-align:middle;animation:mx-loading-rotate .9s linear infinite}.mx-loading .mx-loading-dot-spoke{position:absolute;left:0;top:0;width:100%;height:100%}.mx-loading .mx-loading-dot-item{position:absolute;left:50%;top:0;width:24%;height:24%;border-radius:50%;background-color:#ca0e2d;transform-origin:center center}.mx-loading.mx-loading-petal{position:relative;display:inline-block;vertical-align:middle;animation:mx-loading-rotate .9s linear infinite}.mx-loading .mx-loading-petal-spoke{position:absolute;left:0;top:0;width:100%;height:100%}.mx-loading .mx-loading-petal-item{position:absolute;left:50%;top:8%;width:10%;height:18%;border-radius:999rpx;background-color:#ca0e2d;transform:translateX(-50%)}.mx-loading.mx-loading-mini{display:inline-flex;justify-content:center;align-items:center;vertical-align:middle;min-width:66rpx;min-height:66rpx;width:auto;height:auto}.mx-loading .mx-loading-mini-item{flex:0 0 8rpx;width:8rpx;height:8rpx;margin-right:16rpx;overflow:hidden;border-radius:4rpx;background-color:#9aa0b1;animation:mx-loading-bounce 1s 0s infinite linear}.mx-loading .mx-loading-mini-item.mx-loading-mini-item-1{animation-delay:0s}.mx-loading .mx-loading-mini-item.mx-loading-mini-item-2{animation-delay:150ms}.mx-loading .mx-loading-mini-item.mx-loading-mini-item-3{margin-right:0;animation-delay:.3s}@keyframes mx-loading-rotate{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}@keyframes mx-loading-bounce{0%{transform:translate3d(0,0,0)}12%{transform:translate3d(0,-150%,0)}40%{transform:translate3d(0,110%,0)}55%{transform:translate3d(0,-10%,0)}60%{transform:translate3d(0,0,0)}100%{transform:translate3d(0,0,0)}}