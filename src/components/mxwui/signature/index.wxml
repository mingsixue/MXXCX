<view class="mx-signature {{disabled ? 'mx-signature-disabled' : ''}} {{readonly ? 'mx-signature-readonly' : ''}}" style="{{customStyle}}"><view class="mx-signature-board" style="height:{{height}}rpx;background-color:{{bgColor}};"><view wx:if="{{isEmpty && placeholder}}" class="mx-signature-placeholder">{{placeholder}}</view><canvas wx:if="{{canvasId && canvasWidth && canvasHeight}}" type="2d" id="{{canvasId}}" class="mx-signature-canvas" disable-scroll="{{true}}" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;" catchtouchstart="handleTouchStart" catchtouchmove="handleTouchMove" catchtouchend="handleTouchEnd" catchtouchcancel="handleTouchEnd" ></canvas></view><view class="mx-signature-actions" wx:if="{{showClear || showConfirm}}"><mx-btn wx:if="{{showClear}}" type="default" small width="160rpx" disabled="{{disabled || readonly || isEmpty}}" bind:btn_tap="handleClearTap" >{{clearText}}</mx-btn><mx-btn wx:if="{{showConfirm}}" small width="160rpx" disabled="{{disabled || readonly || isEmpty}}" bind:btn_tap="handleConfirmTap" >{{confirmText}}</mx-btn></view></view> 