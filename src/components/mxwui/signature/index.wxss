.mx-signature{box-sizing:border-box;width:100%}.mx-signature .mx-signature-board{position:relative;width:100%;overflow:hidden;border:2rpx solid #e1e5ec;border-radius:16rpx;box-sizing:border-box}.mx-signature .mx-signature-placeholder{position:absolute;top:50%;left:50%;z-index:2;transform:translate(-50%,-50%);color:#9aa0b1;font-size:28rpx;line-height:1.4;pointer-events:none;white-space:nowrap}.mx-signature .mx-signature-canvas{position:relative;z-index:1;display:block;width:100%;height:100%}.mx-signature .mx-signature-actions{display:flex;flex-direction:row;justify-content:flex-end;align-items:center;gap:24rpx;margin-top:24rpx}.mx-signature.mx-signature-disabled .mx-signature-board,.mx-signature.mx-signature-readonly .mx-signature-board{opacity:.72}