<view class="mx-steps mx-steps-{{direction}} mx-steps-type-{{type}}"><view wx:for="{{stepList}}" wx:key="index" class="mx-steps-item mx-steps-item-{{direction}} mx-steps-item-{{item.stepStatus}} {{item.isLast ? 'is-last' : ''}} {{clickable && !item.disabled ? 'is-clickable' : ''}}" bind:tap="handleTap" data-index="{{item.index}}" data-item="{{item}}" ><view class="mx-steps-indicator mx-steps-indicator-{{direction}}"><view class="mx-steps-icon mx-steps-icon-{{item.stepStatus}} {{type === 'dot' ? 'mx-steps-icon-dot' : ''}}" style="background:{{item.iconBg}};border-color:{{type === 'dot' ? item.iconBg : (item.stepStatus === 'wait' ? item.iconColor : item.iconBg)}};" ><block wx:if="{{type !== 'dot'}}"><image wx:if="{{item.iconUrl}}" class="mx-steps-icon-img" mode="aspectFit" src="{{item.iconUrl}}" /><mx-icon wx:elif="{{item.iconName}}" name="{{item.iconName}}" color="{{item.iconColor}}" size="28" /><mx-icon wx:elif="{{item.stepStatus === 'finish'}}" name="success" color="{{item.iconColor}}" size="28" /><mx-icon wx:elif="{{item.stepStatus === 'error'}}" name="close" color="{{item.iconColor}}" size="24" /><text wx:else class="mx-steps-num" style="color:{{item.iconColor}};">{{item.num}}</text></block></view><view wx:if="{{!item.isLast}}" class="mx-steps-line mx-steps-line-{{direction}}" style="background:{{item.lineColor}};" ></view></view><view class="mx-steps-content mx-steps-content-{{direction}}"><view class="mx-steps-title" style="color:{{item.stepStatus === 'error' ? errorColor : (item.stepStatus === 'process' ? activeColor : titleColor)}};" >{{item.title}}</view><view wx:if="{{item.desc}}" class="mx-steps-desc" style="color:{{descColor}};" >{{item.desc}}</view></view></view></view> 