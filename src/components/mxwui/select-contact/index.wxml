<view class="mx-select-contact" style="height:{{height}};{{customStyle}}"><view wx:if="{{searchable}}" class="mx-select-contact-search"><view class="mx-select-contact-search-main" bind:tap="handleSearchFocus"><mx-search value="{{searchValue}}" placeholder="{{placeholder}}" showBtn="{{false}}" debounce="{{localSearch ? 0 : 300}}" bind:search_change="handleSearchChange" /></view><view wx:if="{{showSearch}}" class="mx-select-contact-cancel" bind:tap="handleSearchCancel" >取消</view></view><view wx:if="{{loading}}" class="mx-select-contact-loading"><mx-loading type="spin" size="medium" /><view class="mx-select-contact-loading-text">加载中</view></view><view wx:elif="{{showSearch}}" class="mx-select-contact-search-panel"><view wx:if="{{searchStatus === 'loading'}}" class="mx-select-contact-search-loading"><mx-loading type="mini" /><text class="mx-select-contact-search-loading-text">搜索中</text></view><view wx:elif="{{searchStatus === 'empty'}}" class="mx-select-contact-empty-inner"><mx-icon name="empty" size="88" color="{{PLACEHOLDER_COLOR}}" /><view class="mx-select-contact-empty-text">{{searchEmptyText}}</view></view><scroll-view wx:elif="{{searchList.length}}" class="mx-select-contact-search-scroll" scroll-y enhanced show-scrollbar="{{false}}" ><view wx:for="{{searchList}}" wx:key="userId" class="mx-select-contact-item" bind:tap="handleItemTap" data-item="{{item}}" data-source="search" ><mx-avatar url="{{item.avatar}}" size="{{avatarSize}}" round /><view class="mx-select-contact-item-main"><view class="mx-select-contact-item-name"><view class="mx-select-contact-item-name-text"><block wx:if="{{item.nodes && item.nodes.length}}"><text wx:for="{{item.nodes}}" wx:for-item="node" wx:key="index" style="{{node.light ? 'color:' + highlightColor + ';' : ''}}" >{{node.text}}</text></block><text wx:else>{{item.displayName || item.name}}</text></view><text wx:if="{{item.tag}}" class="mx-select-contact-tag" style="color:{{tagColor}};border-color:{{tagBorderColor}};" >{{item.tag}}</text></view><view wx:if="{{item.loginId || item.desc}}" class="mx-select-contact-item-desc"> {{item.loginId || item.desc}} </view></view></view></scroll-view><view wx:else class="mx-select-contact-search-hint"><text class="mx-select-contact-search-hint-text">输入关键词查找联系人</text></view></view><view wx:else class="mx-select-contact-body"><view wx:if="{{contactListEmpty}}" class="mx-select-contact-empty"><view class="mx-select-contact-empty-inner"><mx-icon name="empty" size="88" color="{{PLACEHOLDER_COLOR}}" /><view class="mx-select-contact-empty-text">{{emptyText}}</view></view></view><scroll-view wx:else class="mx-select-contact-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}" scroll-with-animation ><block wx:for="{{recommendSections}}" wx:key="sectionId" wx:for-item="section"><view id="mx-sc-{{section.sectionId}}" class="mx-select-contact-group"><view class="mx-select-contact-title first-level">{{section.name}}</view><view wx:for="{{section.value}}" wx:key="userId" wx:for-item="row" class="mx-select-contact-item" bind:tap="handleItemTap" data-item="{{row}}" data-source="{{section.personSource}}" ><mx-avatar url="{{row.avatar}}" size="{{avatarSize}}" round /><view class="mx-select-contact-item-main"><view class="mx-select-contact-item-name"><view class="mx-select-contact-item-name-text">{{row.displayName || row.name}}</view><text wx:if="{{row.tag}}" class="mx-select-contact-tag" style="color:{{tagColor}};border-color:{{tagBorderColor}};" >{{row.tag}}</text></view><view wx:if="{{row.loginId || row.desc}}" class="mx-select-contact-item-desc"> {{row.loginId || row.desc}} </view></view></view></view></block><block wx:for="{{contactSections}}" wx:key="sectionId" wx:for-item="section"><view id="mx-sc-{{section.sectionId}}" class="mx-select-contact-group"><view class="mx-select-contact-title {{section.className || ''}}">{{section.name}}</view><view wx:for="{{section.value}}" wx:key="userId" wx:for-item="row" class="mx-select-contact-item" bind:tap="handleItemTap" data-item="{{row}}" data-source="{{section.personSource}}" ><mx-avatar url="{{row.avatar}}" size="{{avatarSize}}" round /><view class="mx-select-contact-item-main"><view class="mx-select-contact-item-name"><view class="mx-select-contact-item-name-text">{{row.displayName || row.name}}</view><text wx:if="{{row.tag}}" class="mx-select-contact-tag" style="color:{{tagColor}};border-color:{{tagBorderColor}};" >{{row.tag}}</text></view><view wx:if="{{row.loginId || row.desc}}" class="mx-select-contact-item-desc"> {{row.loginId || row.desc}} </view></view></view></view></block><view class="mx-select-contact-safe"></view></scroll-view><view wx:if="{{alphabet.length}}" class="mx-select-contact-side"><view wx:if="{{showMask}}" class="mx-select-contact-mask" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" ></view><view class="mx-select-contact-side-content" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd" ><view wx:for="{{alphabet}}" wx:key="label" id="mx-sc-alphabet-{{index}}" class="mx-select-contact-side-item" style="height:{{indexSize}}px;width:{{indexSize}}px;" ><view class="mx-select-contact-side-label {{currentKey === index ? 'is-active' : ''}}" style="{{currentKey === index ? 'background:' + activeColor + ';color:' + WHITE_COLOR + ';' : 'color:' + PLACEHOLDER_COLOR + ';'}}width:{{indexSize}}px;height:{{indexSize}}px;line-height:{{indexSize}}px;font-size:{{indexSize * 0.7}}px;" >{{item.label}}</view><view wx:if="{{moving && touchKey === item.label}}" class="mx-select-contact-tip" style="background:#CCCCCC;color:{{WHITE_COLOR}};" >{{item.label}}</view></view></view></view></view></view> 