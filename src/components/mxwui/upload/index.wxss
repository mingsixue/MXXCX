.mx-upload.mx-upload-disabled{opacity:.5;pointer-events:none}.mx-upload .upload-wrap{position:relative;border-radius:4rpx;overflow:hidden;background:#f8f9fa}.mx-upload .upload-wrap .results{position:absolute;top:50%;left:50%;z-index:2;transform:translate(-50%,-50%);width:100%;text-align:center}.mx-upload .upload-wrap .txt{display:block;margin-top:8rpx;color:#9aa0b1;font-size:24rpx}.mx-upload .upload-wrap .results-small .txt{margin-top:4rpx;font-size:20rpx}.mx-upload .result-wrap{position:relative;border-radius:4rpx}.mx-upload .result-wrap .cover{width:100%;height:100%;border-radius:4rpx;overflow:hidden}.mx-upload .result-wrap .del{position:absolute;top:6rpx;right:6rpx;z-index:3;display:flex;align-items:center;justify-content:center;line-height:1}.mx-upload .result-wrap .file-placeholder{display:flex;align-items:center;justify-content:center;border-radius:4rpx;background:#f8f9fa;box-sizing:border-box}.mx-upload .result-wrap .play{position:absolute;top:50%;left:50%;z-index:3;transform:translate(-50%,-50%);width:72rpx;height:72rpx;background:url(https://cdn.mingsixue.com/xcx/MXWUI/play.png) no-repeat;background-size:cover;pointer-events:none}.mx-upload .result-wrap .results{position:absolute;top:0;left:0;z-index:2;width:100%;height:100%;border-radius:4rpx;background:rgba(0,0,0,.5);text-align:center}.mx-upload .result-wrap .results .result{position:absolute;top:50%;left:50%;z-index:2;transform:translate(-50%,-50%);width:100%;text-align:center}.mx-upload .result-wrap .results .txt{display:block;margin-top:16rpx;font-size:24rpx;color:#fff}.mx-upload .result-wrap .results .retry{display:block;margin-top:8rpx;font-size:22rpx;color:rgba(255,255,255,.85)}