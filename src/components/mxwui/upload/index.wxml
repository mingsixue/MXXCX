<view class="mx-upload {{disabled ? 'mx-upload-disabled' : ''}} {{small ? 'mx-upload-small' : ''}}"><view wx:if="{{src}}" class="result-wrap" style="width:{{boxWidth}}rpx;height:{{boxWidth}}rpx;" bind:tap="handlePreview" ><image wx:if="{{type != 'file' || cover}}" class="cover" mode="aspectFill" src="{{type == 'image' ? src : (cover || src)}}" style="width:{{boxWidth}}rpx;height:{{boxWidth}}rpx;" /><view wx:else class="file-placeholder" style="width:{{boxWidth}}rpx;height:{{boxWidth}}rpx;"><mx-icon name="file" color="{{PLACEHOLDER_COLOR}}" size="{{addIconSize}}" /></view><view wx:if="{{type == 'video' && !showUploading && !showFail}}" class="play"></view><view wx:if="{{showUploading}}" class="results"><view class="result"><mx-loading type="spin" size="small" color="{{WHITE_COLOR}}" /><view class="txt">{{percent > 0 ? (percent + '%') : '上传中'}}</view></view></view><view wx:if="{{showFail}}" class="results" catch:tap="handleRetry"><view class="result"><mx-icon name="common_close" color="rgba(255,255,255,0.7)" size="{{addIconSize}}" /><view class="txt">上传失败</view><view class="retry">点击重试</view></view></view><view wx:if="{{deletable && !disabled}}" class="del" catch:tap="handleDel"><mx-icon name="close_fill" color="rgba(4, 10, 35, 0.65)" size="{{delIconSize}}" /></view></view><view wx:else class="upload-wrap" style="width:{{boxWidth}}rpx;height:{{boxWidth}}rpx;" bind:tap="handleUpload"><view class="results {{small ? 'results-small' : ''}}"><mx-icon name="common_add" color="{{PLACEHOLDER_COLOR}}" size="{{addIconSize}}" /><view class="txt">{{displayText}}</view></view></view></view> 