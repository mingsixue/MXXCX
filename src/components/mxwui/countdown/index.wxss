.mx-countdown{display:inline-flex;align-items:center;font-size:26rpx;line-height:40rpx;color:#656979}.mx-countdown-prefix{flex-shrink:0;padding-right:4rpx}.mx-countdown-suffix{flex-shrink:0;padding-left:4rpx}.mx-countdown-unit{flex-shrink:0;width:28rpx;margin-right:4rpx;text-align:center}.mx-countdown-colon{flex-shrink:0;width:20rpx;margin:0;line-height:40rpx;text-align:center}.mx-countdown-num{box-sizing:border-box;display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;width:44rpx;height:40rpx;margin:0 6rpx;padding:0;border-radius:6rpx;font-size:26rpx;line-height:40rpx;letter-spacing:0;font-variant-numeric:tabular-nums;text-align:center;color:#fff;background-color:#ca0e2d}.mx-countdown-num-day{width:auto;min-width:44rpx;padding:0 4rpx}