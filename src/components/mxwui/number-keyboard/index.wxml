<view class="mx-number-keyboard {{className}}" wx:if="{{visible}}" style="z-index:{{zIndex}};" catch:touchmove="preventTouchMove" ><view class="mx-number-keyboard-mask" bind:tap="handleMaskTap"></view><view class="mx-number-keyboard-panel"><slot name="header"></slot><view wx:if="{{closeable}}" class="mx-number-keyboard-close" bind:tap="handleCloseTap" ><mx-icon name="arrows_bottom" color="{{MINOR_TEXT_COLOR}}" size="40" /></view><view class="mx-number-keyboard-body {{hasConfirm ? 'mx-number-keyboard-body-confirm' : ''}}"><view class="mx-number-keyboard-keys"><view class="mx-number-keyboard-row" wx:for="{{displayArr}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex" ><view class="mx-number-keyboard-key" wx:for="{{row}}" wx:for-item="itemKey" wx:key="*this" data-key="{{itemKey}}" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" >{{itemKey}}</view></view><view wx:if="{{!hasConfirm}}" class="mx-number-keyboard-row"><view wx:if="{{extraKey}}" class="mx-number-keyboard-key" data-key="{{extraKey}}" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" >{{extraKey}}</view><view wx:else class="mx-number-keyboard-key mx-number-keyboard-key-empty"></view><view class="mx-number-keyboard-key" data-key="0" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" >0</view><view class="mx-number-keyboard-key mx-number-keyboard-key-del" data-key="del" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" ><mx-icon name="delete" color="{{TEXT_COLOR}}" size="48" /></view></view><view wx:else class="mx-number-keyboard-row"><view class="mx-number-keyboard-key mx-number-keyboard-key-zero" data-key="0" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" >0</view><view wx:if="{{extraKey}}" class="mx-number-keyboard-key" data-key="{{extraKey}}" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" >{{extraKey}}</view><view wx:else class="mx-number-keyboard-key mx-number-keyboard-key-empty"></view></view></view><view wx:if="{{hasConfirm}}" class="mx-number-keyboard-function"><view class="mx-number-keyboard-key mx-number-keyboard-key-del" data-key="del" bind:tap="tapKey" hover-class="mx-number-keyboard-key-active" hover-stay-time="70" ><mx-icon name="delete" color="{{TEXT_COLOR}}" size="48" /></view><view class="mx-number-keyboard-confirm {{confirmDisabled ? 'mx-number-keyboard-confirm-disabled' : ''}}" data-key="enter" bind:tap="tapKey" hover-class="{{confirmDisabled ? '' : 'mx-number-keyboard-confirm-active'}}" hover-stay-time="70" ><view class="mx-number-keyboard-confirm-slot"><slot name="confirm"></slot></view><view class="mx-number-keyboard-confirm-text"><view class="mx-number-keyboard-confirm-char" wx:for="{{confirmChars}}" wx:for-index="charIdx" wx:key="charIdx" style="color:{{confirmDisabled ? '' : confirmColor}};" >{{item}}</view></view></view></view></view><view wx:if="{{safeArea}}" class="mx-number-keyboard-safe"></view></view></view> 