.mx-number-keyboard{position:fixed;top:0;right:0;bottom:0;left:0;width:100vw;height:100vh}.mx-number-keyboard .mx-number-keyboard-mask{position:absolute;top:0;right:0;bottom:0;left:0;z-index:1;background:0 0}.mx-number-keyboard .mx-number-keyboard-panel{position:absolute;right:0;bottom:0;left:0;z-index:2;width:100%;padding:16rpx 16rpx 0;box-sizing:border-box;background:#eff0f5;animation:mx-number-keyboard-slide-up .2s linear}.mx-number-keyboard .mx-number-keyboard-close{display:flex;align-items:center;justify-content:center;width:100%;height:72rpx;margin-bottom:8rpx;color:#656979}.mx-number-keyboard .mx-number-keyboard-body{display:flex;width:100%}.mx-number-keyboard .mx-number-keyboard-body.mx-number-keyboard-body-confirm .mx-number-keyboard-keys{flex:3;margin-right:12rpx}.mx-number-keyboard .mx-number-keyboard-body.mx-number-keyboard-body-confirm .mx-number-keyboard-function{flex:1}.mx-number-keyboard .mx-number-keyboard-keys{flex:1;display:flex;flex-direction:column}.mx-number-keyboard .mx-number-keyboard-row{display:flex;width:100%;margin-bottom:12rpx}.mx-number-keyboard .mx-number-keyboard-row .mx-number-keyboard-key{margin-right:12rpx}.mx-number-keyboard .mx-number-keyboard-row .mx-number-keyboard-key:last-child{margin-right:0}.mx-number-keyboard .mx-number-keyboard-key{flex:1;display:flex;align-items:center;justify-content:center;height:108rpx;font-size:48rpx;font-family:PingFangSC-Medium,PingFang SC,sans-serif;font-weight:500;color:#040a23;background:#fff;border-radius:12rpx;box-shadow:0 2rpx 0 rgba(0,0,0,.04);-webkit-user-select:none;-moz-user-select:none;user-select:none}.mx-number-keyboard .mx-number-keyboard-key.mx-number-keyboard-key-zero{flex:2.08}.mx-number-keyboard .mx-number-keyboard-key.mx-number-keyboard-key-empty{background:0 0;box-shadow:none}.mx-number-keyboard .mx-number-keyboard-key.mx-number-keyboard-key-del{font-size:40rpx}.mx-number-keyboard .mx-number-keyboard-key-active{background:#e5e6eb!important}.mx-number-keyboard .mx-number-keyboard