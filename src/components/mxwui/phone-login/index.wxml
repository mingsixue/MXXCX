<view class="mx-phone-login"><view class="mx-phone-login__header" wx:if="{{logo || title || desc}}"><image wx:if="{{logo}}" class="mx-phone-login__logo" src="{{logo}}" mode="aspectFill" style="width:{{logoSize}}rpx;height:{{logoSize}}rpx;" /><view wx:if="{{title}}" class="mx-phone-login__title">{{title}}</view><view wx:if="{{desc}}" class="mx-phone-login__desc">{{desc}}</view></view><view class="mx-phone-login__slot"><slot></slot></view><view class="mx-phone-login__action"><mx-btn wx:if="{{!canAuthorize}}" type="{{btnType}}" themeColor="{{themeColor}}" width="{{btnWidth}}" round="{{round}}" disabled="{{disabled}}" bind:btn_tap="handleBlockedTap" >{{btnText}}</mx-btn><mx-btn wx:else type="{{btnType}}" themeColor="{{themeColor}}" width="{{btnWidth}}" round="{{round}}" disabled="{{disabled}}" openType="{{openType}}" phoneNumberNoQuotaToast="{{phoneNumberNoQuotaToast}}" bind:get_phone_number="handleGetPhoneNumber" bind:get_real_time_phone_number="handleGetRealtimePhoneNumber" >{{btnText}}</mx-btn></view><view class="mx-phone-login__protocol" wx:if="{{showProtocol}}"><mx-protocol content="{{protocolContent}}" checked="{{innerChecked}}" checkboxColor="{{checkboxColor}}" checkboxSelectColor="{{checkboxSelectColor}}" checkboxSize="{{checkboxSize}}" bind:protocol_change="handleProtocolChange" bind:protocol_click="handleProtocolClick" /></view></view> 