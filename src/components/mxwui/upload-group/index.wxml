<view class="mx-upload-group"><view class="upload-group-wrap upload-group-column{{column}}"><view class="item" wx:for="{{list}}" wx:key="uid" style="width:{{itemWidth}}rpx;height:{{itemWidth}}rpx;" ><mx-upload type="{{type}}" width="{{itemWidth}}" src="{{item.src}}" cover="{{item.cover}}" status="{{item.status}}" percent="{{item.percent}}" isFail="{{item.isFail}}" disabled="{{disabled}}" deletable="{{deletable}}" sourceType="{{sourceType}}" maxSize="{{maxSize}}" chooseText="{{chooseText}}" previewUrls="{{previewUrls}}" small="{{column > 4}}" data-idx="{{index}}" bind:upload_change="handleChange" bind:upload_choose="handleChoose" bind:upload_retry="handleRetry" bind:upload_oversize="handleOversize" /></view><block wx:for="{{[addKey]}}" wx:for-item="key" wx:key="*this"><view wx:if="{{list.length < limit}}" class="item" style="width:{{itemWidth}}rpx;height:{{itemWidth}}rpx;" ><mx-upload type="{{type}}" width="{{itemWidth}}" src="" cover="" autoPreview="{{false}}" disabled="{{disabled}}" sourceType="{{sourceType}}" maxSize="{{maxSize}}" chooseText="{{chooseText}}" small="{{column > 4}}" data-idx="{{list.length}}" bind:upload_change="handleChange" bind:upload_choose="handleChoose" bind:upload_oversize="handleOversize" /></view></block></view></view> 