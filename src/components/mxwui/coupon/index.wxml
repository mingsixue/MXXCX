<view class="mx-coupon mx-coupon--{{direction}} {{isMultiple ? 'mx-coupon--multiple' : ''}} {{isSmall ? 'mx-coupon--small' : 'mx-coupon--large'}}" style="{{customStyle}}" ><view wx:for="{{list}}" wx:key="index" class="mx-coupon__item {{item.disabled ? 'mx-coupon__item--disabled' : ''}}" style="--coupon-theme: {{themeColor}};" data-index="{{index}}" bind:tap="handleCouponTap" ><view class="mx-coupon__left"><view class="mx-coupon__money {{item.moneySmall ? 'mx-coupon__money--small' : ''}}"><text class="mx-coupon__money-num">{{item.money}}</text><text class="mx-coupon__money-unit">{{item.moneyUnit}}</text></view><view wx:if="{{item.threshold}}" class="mx-coupon__threshold">{{item.threshold}}</view></view><view class="mx-coupon__divider"><view class="mx-coupon__notch mx-coupon__notch--top"></view><view class="mx-coupon__dash"></view><view class="mx-coupon__notch mx-coupon__notch--bottom"></view></view><view class="mx-coupon__right"><view class="mx-coupon__main"><view class="mx-coupon__content"><view class="mx-coupon__title">{{item.title}}</view><view wx:if="{{item.desc}}" class="mx-coupon__desc">{{item.desc}}</view></view><view wx:if="{{item.actionAreaInfo}}" class="mx-coupon__action" data-index="{{index}}" catch:tap="handleBtnTap" ><image wx:if="{{item.actionAreaInfo.imageUrl}}" class="mx-coupon__action-img" mode="aspectFit" src="{{item.actionAreaInfo.imageUrl}}" /><view wx:elif="{{item.actionAreaInfo.text}}" class="mx-coupon__action-btn {{item.actionAreaInfo.disabled || item.disabled ? 'mx-coupon__action-btn--disabled' : ''}}" >{{item.actionAreaInfo.text}}</view></view><view wx:else class="mx-coupon__action"><slot name="action" /></view></view><view wx:if="{{item.validTimeText}}" class="mx-coupon__valid">{{item.validTimeText}}</view></view></view></view> 