.mx-toast-root{position:fixed;left:0;top:0;right:0;bottom:0;pointer-events:none}.mx-toast-mask{position:absolute;left:0;top:0;right:0;bottom:0;background-color:rgba(0,0,0,.45);pointer-events:auto;animation:mx-toast-mask-in .2s ease both}.mx-toast{position:absolute;left:50%;top:50%;transform:translate3d(-50%,-50%,0);box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:24rpx 32rpx;max-width:444rpx;color:#fff;background:rgba(0,0,0,.75);pointer-events:auto;animation:mx-toast-in .2s ease both}.mx-toast.mx-toast-text-long{border-radius:24rpx}.mx-toast.mx-toast-text-short{border-radius:999rpx}.mx-toast.mx-toast-with-media{width:240rpx;min-height:240rpx;padding:32rpx 24rpx;border-radius:32rpx}.mx-toast-media{display:flex;justify-content:center;align-items:center;width:80rpx;height:80rpx;margin-bottom:20rpx;overflow:hidden}.mx-toast-image{width:80rpx;height:80rpx}.mx-toast-text{box-sizing:border-box;max-width:380rpx;max-height:80rpx;overflow:hidden}.mx-toast-content{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:28rpx;line-height:40rpx;text-align:center;word-break:break-all;text-overflow:ellipsis}@keyframes mx-toast-in{0%{opacity:0;transform:translate3d(-50%,-50%,0) scale(.85)}100%{opacity:1;transform:translate3d(-50%,-50%,0) scale(1)}}@keyframes mx-toast-mask-in{0%{opacity:0}100%{opacity:1}}