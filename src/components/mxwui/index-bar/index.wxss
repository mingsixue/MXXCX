.mx-index-bar{position:relative;width:100%;overflow:hidden;background:#fff;box-sizing:border-box}.mx-index-bar-scroll{width:100%;height:100%;box-sizing:border-box}.mx-index-bar-slot{width:100%;height:100%}.mx-index-bar-group{background:#fff}.mx-index-bar-header{padding:8rpx 24rpx;font-size:26rpx;line-height:1.4;z-index:2}.mx-index-bar-header.is-sticky{position:sticky;top:0}.mx-index-bar-item{display:flex;align-items:center;padding:20rpx 24rpx;margin-right:40rpx;border-bottom:2rpx solid #e1e5ec;box-sizing:border-box}.mx-index-bar-item:last-child{border-bottom:none}.mx-index-bar-item-main{flex:1;margin-left:20rpx;min-width:0}.mx-index-bar-item-name{font-size:30rpx;color:#040a23;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mx-index-bar-item-desc{margin-top:4rpx;font-size:24rpx;color:#9aa0b1;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mx-index-bar-safe{height:40rpx}.mx-index-bar-side{position:absolute;right:0;top:0;bottom:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:0 8rpx 0 20rpx;box-sizing:border-box;pointer-events:none}.mx-index-bar-mask{position:fixed;left:0;top:0;width:100vw;height:100vh;z-index:9;pointer-events:auto}.mx-index-bar-side-content{position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:auto}.mx-index-bar-side-item{position:relative;display:flex;align-items:center;justify-content:center}.mx-index-bar-side-label{display:flex;align-items:center;justify-content:center;font-weight:700;border-radius:50%;box-sizing:border-box}.mx-index-bar-tip{position:absolute;left:-120rpx;top:50%;transform:translateY(-50%);width:88rpx;height:88rpx;border-radius:50%;line-height:88rpx;text-align:center;font-size:40rpx;font-weight:700;z-index:11;pointer-events:none}