<view class="mx-index-bar" style="height:{{height}};"><scroll-view wx:if="{{list.length}}" class="mx-index-bar-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}" scroll-with-animation bindscroll="onScroll" ><view wx:for="{{list}}" wx:key="index" wx:for-item="group" wx:for-index="gidx" id="mx-index-{{group.index}}" class="mx-index-bar-group" ><view class="mx-index-bar-header {{sticky ? 'is-sticky' : ''}}" style="background:{{headerBgColor}};color:{{headerColor}};" >{{group.index}}</view><view class="mx-index-bar-item" wx:for="{{group.children}}" wx:key="name" wx:for-item="row" wx:for-index="ridx" bind:tap="handleItemTap" data-item="{{row}}" data-group="{{group}}" data-index="{{ridx}}" data-gidx="{{gidx}}" ><mx-avatar wx:if="{{showAvatar && row.avatar}}" url="{{row.avatar}}" size="{{avatarSize}}" round /><mx-avatar wx:elif="{{showAvatar}}" size="{{avatarSize}}" round /><view class="mx-index-bar-item-main"><view class="mx-index-bar-item-name">{{row.name}}</view><view wx:if="{{row.desc}}" class="mx-index-bar-item-desc">{{row.desc}}</view></view></view></view><view class="mx-index-bar-safe"></view></scroll-view><view wx:else class="mx-index-bar-slot"><slot></slot></view><view class="mx-index-bar-side"><view wx:if="{{showMask}}" class="mx-index-bar-mask" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" ></view><view class="mx-index-bar-side-content" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd" ><view wx:for="{{indexList}}" wx:key="label" id="mx-alphabet-{{index}}" class="mx-index-bar-side-item" style="height:{{size}}px;width:{{size}}px;" ><view class="mx-index-bar-side-label {{currentKey === index ? 'is-active' : ''}}" style="{{currentKey === index ? 'background:' + activeColor + ';color:' + tipColor + ';' : 'color:' + textColor + ';'}}width:{{size}}px;height:{{size}}px;line-height:{{size}}px;font-size:{{size * 0.7}}px;" >{{item.label}}</view><view wx:if="{{moving && touchKey === item.label && !item.disablePreview}}" class="mx-index-bar-tip" style="background:{{tipBgColor}};color:{{tipColor}};" >{{item.label}}</view></view></view></view></view> 