<view class="mx-protocol-dialog" wx:if="{{visible}}" style="z-index:{{zIndex}};"><mx-mask visible="{{true}}" zIndex="1" bind:mask_tap="handleMask" /><view class="mx-protocol-dialog-wrap"><view wx:if="{{showTitle && title}}" class="mx-protocol-dialog-title" style="color:{{titleColor}};">{{title}}</view><view class="mx-protocol-dialog-cons {{showTitle && title ? '' : 'no-title'}}"><scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="mx-protocol-dialog-scroll" scroll-top="{{scrollTop}}" lower-threshold="40" bindscrolltolower="handleScrollToLower" bindscroll="handleScroll" ><view class="mx-protocol-dialog-scroll-inner"><view wx:if="{{content}}" class="mx-protocol-dialog-msgs" style="color:{{contentColor}};">{{content}}</view><slot></slot></view></scroll-view></view><view wx:if="{{confirmBtn || cancelBtn}}" class="mx-protocol-dialog-btns"><view wx:if="{{cancelBtn}}" class="btn btn-minor" style="color:{{cancelBtnColor}};" bind:tap="handleCancel" >{{cancelBtnText}}</view><view wx:if="{{confirmBtn}}" class="btn btn-main {{confirmDisabled ? 'btn-disabled' : ''}}" style="{{confirmStyle}}" bind:tap="handleConfirm" >{{displayConfirmText}}</view></view></view></view> 