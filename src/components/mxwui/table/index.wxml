<view class="mx-table {{isFull ? 'mx-table-full' : ''}}" style="{{customStyle}}"><scroll-view class="mx-table-scroll {{scrollStyle ? 'mx-table-scroll-fixed' : ''}}" style="{{scrollStyle}}" scroll-x="{{!isFull}}" scroll-y="{{!!scrollStyle}}" enhanced show-scrollbar="{{false}}" bindscroll="handleScroll" ><view class="mx-table-inner" style="{{isFull ? '' : innerWidthStyle}}" ><view wx:if="{{headerRow}}" class="mx-table-row mx-table-row-header {{isFull ? 'mx-table-row-full' : ''}}"><view wx:for="{{headerRow.cells}}" wx:for-item="cell" wx:for-index="colIndex" wx:key="key" class="mx-table-cell mx-table-th {{cell.alignClass}} {{cell.fixed ? 'mx-table-cell-fixed' : ''}} {{cell.fixed && showFixedShadow ? 'mx-table-cell-shadow' : ''}}" style="{{cell.widthStyle}}{{cell.headerBgStyle}}" data-index="{{colIndex}}" catchtap="handleSort" ><text class="mx-table-th-text">{{cell.title}}</text><view wx:if="{{cell.sorter}}" class="mx-table-sorter"><view class="mx-table-sorter-icon mx-table-sorter-up {{cell.sorterStatus === 'forward' ? 'active' : ''}}"></view><view class="mx-table-sorter-icon mx-table-sorter-down {{cell.sorterStatus === 'reverse' ? 'active' : ''}}"></view></view></view></view><block wx:if="{{!isEmpty}}"><view wx:for="{{bodyRows}}" wx:for-item="row" wx:key="key" class="mx-table-row {{isFull ? 'mx-table-row-full' : ''}}" data-index="{{row.index}}" bindtap="handleRowTap" ><view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="key" class="mx-table-cell mx-table-td {{cell.alignClass}} {{cell.fixed ? 'mx-table-cell-fixed' : ''}} {{cell.fixed && showFixedShadow ? 'mx-table-cell-shadow' : ''}}" style="{{cell.widthStyle}}{{cell.stripeStyle}}" data-row-index="{{row.index}}" data-col-index="{{cell.index}}" bindtap="handleCellTap" ><view wx:if="{{cell.ellipsisRow}}" class="mx-table-cell-text mx-table-cell-ellipsis" style="{{cell.ellipsisStyle}}" >{{cell.value}}</view><view wx:else class="mx-table-cell-text">{{cell.value}}</view></view></view></block><view wx:else class="mx-table-empty"><view class="mx-table-empty-inner" style="{{emptyInnerStyle}}"><slot></slot><view wx:if="{{emptyIconUrl || emptyIcon || emptyText}}" class="mx-table-empty-default" ><view wx:if="{{emptyIconUrl || emptyIcon}}" class="mx-table-empty-icon"><image wx:if="{{emptyIconUrl}}" class="mx-table-empty-image" mode="aspectFit" src="{{emptyIconUrl}}" style="width:{{emptyIconSize}}rpx;height:{{emptyIconSize}}rpx;" /><mx-icon wx:else name="{{emptyIcon}}" size="{{emptyIconSize}}" color="{{emptyIconColor}}" /></view><view wx:if="{{emptyText}}" class="mx-table-empty-text">{{emptyText}}</view></view></view></view></view></scroll-view></view> 