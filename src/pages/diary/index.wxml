<mx-nav theme="light" title="日记查询" />

<view class="page {{searched ? 'page--result' : 'page--idle'}}" style="min-height: {{contentHeight}}px;">
    <block wx:if="{{!searched}}">
        <view class="idle">
            <view class="idle-mark">记</view>
            <view class="idle-title">查找日记</view>
            <view class="idle-desc">可按日期或内容关键字查询</view>
            <view class="search-panel">
                <view class="field-label">日期</view>
                <view class="date-pick-wrap">
                    <picker mode="date" value="{{day || today}}" bindchange="handleNativeDayChange">
                        <view class="date-pick {{day ? 'date-pick--on' : ''}}" hover-class="date-pick--hover">
                            <view class="date-pick-icon">日</view>
                            <view class="date-pick-main">
                                <view class="date-pick-value">{{day || '点击选择日期'}}</view>
                                <view class="date-pick-hint" wx:if="{{!day}}">选填，按日期精确查找</view>
                            </view>
                        </view>
                    </picker>
                    <view
                        class="date-clear"
                        wx:if="{{day}}"
                        hover-class="date-clear--hover"
                        catchtap="handleClearDay"
                    >清除</view>
                </view>

                <view class="field-label field-label--gap">关键字</view>
                <view class="search-row">
                    <view class="search-field">
                        <mx-search
                            wx:if="{{searchReady}}"
                            styleType="insert"
                            value="{{keyword}}"
                            placeholder="输入内容关键字"
                            showBtn="{{false}}"
                            bgColor="#f3f4f6"
                            cursorColor="#1f1f1f"
                            bind:search_change="handleSearchChange"
                        />
                    </view>
                    <view class="search-action" hover-class="search-action--hover" bindtap="handleSearch">查询</view>
                </view>
            </view>
            <view class="idle-hint" wx:if="{{loading}}">查询中...</view>
        </view>
    </block>

    <block wx:else>
        <view class="search-sticky">
            <view class="date-pick-wrap date-pick-wrap--compact">
                <picker mode="date" value="{{day || today}}" bindchange="handleNativeDayChange">
                    <view class="date-pick date-pick--compact {{day ? 'date-pick--on' : ''}}" hover-class="date-pick--hover">
                        <view class="date-pick-icon date-pick-icon--sm">日</view>
                        <view class="date-pick-main">
                            <view class="date-pick-value">{{day || '点击选择日期'}}</view>
                        </view>
                    </view>
                </picker>
                <view
                    class="date-clear"
                    wx:if="{{day}}"
                    hover-class="date-clear--hover"
                    catchtap="handleClearDay"
                >清除</view>
            </view>
            <view class="search-row">
                <view class="search-field">
                    <mx-search
                        wx:if="{{searchReady}}"
                        styleType="insert"
                        value="{{keyword}}"
                        placeholder="输入内容关键字"
                        showBtn="{{false}}"
                        bgColor="#f3f4f6"
                        cursorColor="#1f1f1f"
                        bind:search_change="handleSearchChange"
                    />
                </view>
                <view class="search-action" hover-class="search-action--hover" bindtap="handleSearch">查询</view>
            </view>
        </view>

        <view class="result-bar" wx:if="{{!loading}}">
            <text class="result-count">共找到 {{total}} 篇</text>
            <text class="result-clear" bindtap="handleReset">重新查询</text>
        </view>

        <view class="list" wx:if="{{list.length}}">
            <view
                class="card"
                wx:for="{{list}}"
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="handleDetail"
            >
                <view class="card-head">
                    <view class="card-day">{{item.day}}</view>
                    <view class="card-week" wx:if="{{item.week}}">{{item.week}}</view>
                    <view class="card-badge" wx:if="{{item.is_repair_text}}">{{item.is_repair_text}}</view>
                </view>
                <view class="card-content">{{item.content}}</view>
                <view class="card-foot" wx:if="{{item.tags_text || item.affiliation_name}}">
                    <text wx:if="{{item.affiliation_name}}">{{item.affiliation_name}}</text>
                    <text wx:if="{{item.tags_text}}">{{item.affiliation_name ? ' · ' : ''}}{{item.tags_text}}</text>
                </view>
            </view>
        </view>

        <view class="empty-wrap" wx:if="{{!loading && empty}}">
            <view class="empty-mark">记</view>
            <view class="empty-title">未找到相关日记</view>
            <view class="empty-desc">试试其他日期或关键字</view>
        </view>
        <view class="tip tip--center" wx:if="{{loading}}">查询中...</view>
        <view class="tip" wx:if="{{loadingMore}}">加载更多...</view>
        <view class="tip tip--end" wx:if="{{!hasMore && list.length && !loading}}">没有更多了</view>
    </block>
</view>

<view class="diary-foot" wx:if="{{canAdd}}">
    <view class="diary-foot-btn" hover-class="diary-foot-btn--hover" bindtap="handleAdd">新增日记</view>
    <mx-safe-area />
</view>

<mx-dialog-bottom
    visible="{{popupVisible}}"
    height="75vh"
    zIndex="{{1000}}"
    showClose="{{false}}"
    bind:dialog_bottom_close="handlePopupClose"
>
    <view class="diary-popup">
        <view class="diary-popup-close" hover-class="diary-popup-close--hover" bindtap="handlePopupClose">×</view>
        <view class="diary-popup-tip" wx:if="{{popupLoading}}">加载中...</view>
        <view class="diary-popup-tip" wx:elif="{{!popupDetail}}">未找到该日记</view>
        <block wx:else>
            <view class="diary-popup-head">
                <view class="diary-popup-day">{{popupDetail.day}}</view>
                <view class="diary-popup-meta">
                    <text wx:if="{{popupDetail.week}}">{{popupDetail.week}}</text>
                    <text wx:if="{{popupDetail.affiliation_name}}"> · {{popupDetail.affiliation_name}}</text>
                    <text wx:if="{{popupDetail.is_repair_text}}" class="diary-popup-repair"> · {{popupDetail.is_repair_text}}</text>
                </view>
                <view class="diary-popup-tags" wx:if="{{popupTags.length}}">
                    <text class="diary-popup-tag" wx:for="{{popupTags}}" wx:key="*this">{{item}}</text>
                </view>
            </view>
            <scroll-view scroll-y class="diary-popup-body" enhanced show-scrollbar="{{false}}">
                <text class="diary-popup-text" user-select>{{popupDetail.content_full || popupDetail.content}}</text>
            </scroll-view>
        </block>
    </view>
</mx-dialog-bottom>

<debug-panel />
