<mx-nav theme="light" title="过期食品" />

<view class="expired-page" style="min-height: {{contentHeight}}px;">
    <view class="expired-tabs">
        <view
            class="expired-tab {{scope === item.value ? 'expired-tab--active' : ''}}"
            wx:for="{{scopes}}"
            wx:key="value"
            data-value="{{item.value}}"
            data-label="{{item.label}}"
            bindtap="handleScopeTap"
        >{{item.label}}</view>
    </view>
    <view class="expired-summary">
        <view class="expired-summary-title">{{selectedScopeLabel}}</view>
        <view class="expired-summary-count">共 {{total}} 件</view>
    </view>

    <view
        class="expired-item"
        hover-class="expired-item--hover"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="handleDetail"
    >
        <image
            class="expired-thumb"
            wx:if="{{item.photo_urls[0]}}"
            src="{{item.photo_urls[0]}}"
            mode="aspectFill"
        />
        <view class="expired-placeholder" wx:else>食</view>
        <view class="expired-main">
            <view class="expired-name">{{item.name}}</view>
            <view class="expired-meta">{{item.type_text}}{{item.save_way_text ? ' · ' + item.save_way_text : ''}}</view>
            <view class="expired-date-row">
                <view class="expired-date">到期：{{item.expires_time}}</view>
                <view class="expired-days expired-days--{{item.remainingState}}" wx:if="{{item.remainingText}}">
                    {{item.remainingText}}
                </view>
            </view>
        </view>
        <view class="expired-arrow">›</view>
    </view>

    <view class="expired-state" wx:if="{{loading}}">加载中...</view>
    <view class="expired-empty" wx:if="{{!loading && empty}}" style="height: {{contentHeight - 150}}px;">
        <mx-empty
            text=""
            desc="暂无相关食品"
            descColor="#c2c6cd"
            iconName="empty"
            iconColor="#c8ccd3"
            iconSize="{{96}}"
        />
    </view>
    <view class="expired-state" wx:if="{{loadingMore}}">加载更多...</view>
    <view class="expired-state" wx:if="{{!hasMore && list.length && !loading}}">没有更多了</view>
    <mx-safe-area />
</view>
<debug-panel />
