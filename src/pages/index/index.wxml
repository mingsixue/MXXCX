<mx-nav theme="light" title="流年凝雪" />
<view class="page-index">
    <view class="hero">
        <view class="title">流年凝雪</view>
        <view class="desc">记录日常 · 管理家务 · 子明词</view>
        <view class="meta">版本 {{version}} · {{env}} · {{isLogin ? '已登录' : '未登录'}}</view>
    </view>

    <block wx:for="{{groups}}" wx:key="title">
        <view class="group-title">{{item.title}}</view>
        <view class="group">
            <view
                wx:for="{{item.list}}"
                wx:for-item="row"
                wx:key="path"
                data-path="{{row.path}}"
                bind:tap="handleGo"
            >
                <mx-list-basic label="{{row.name}}" arrows="{{true}}" />
            </view>
        </view>
    </block>
</view>

<mx-menu options="{{menus}}" current="{{0}}" selectColor="#292B2F" />
<debug-panel />
