<mx-nav theme="light" title="时间记录" />

<view class="page" style="min-height: {{contentHeight}}px;">
    <view class="meta" wx:if="{{affiliation}}">
        <text>{{userName}}</text>
        <text class="meta-dot">·</text>
        <text class="meta-day">{{day}}</text>
        <text class="meta-dot">·</text>
        <text class="meta-link" bindtap="handleStats">统计</text>
    </view>

    <view class="overview" wx:if="{{affiliation}}">
        <view class="ov-grid">
            <view
                class="ov-tile ov-tile--{{item.tone}} {{item.hasDetail ? 'ov-tile--link' : ''}}"
                wx:for="{{overviewRows}}"
                wx:key="key"
                data-key="{{item.key}}"
                bindtap="handleOverviewTap"
            >
                <view class="ov-left">
                    <view class="ov-mark">{{item.mark}}</view>
                    <text class="ov-name">{{item.name}}</text>
                </view>
                <view class="ov-mid">
                    <text class="ov-primary">{{item.primary}}</text>
                    <text class="ov-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </view>
                <text class="ov-arrow" wx:if="{{item.hasDetail}}">›</text>
                <view class="ov-arrow-placeholder" wx:else></view>
            </view>
        </view>

        <view class="status-line" wx:if="{{statusTags.length}}">
            <text class="status-tag" wx:for="{{statusTags}}" wx:key="*this">{{item}}</text>
        </view>
    </view>

    <view class="actions" wx:if="{{affiliation}}">
        <view class="act-group act-group--work">
            <view class="act-head">工作</view>
            <view class="act-grid">
                <view
                    class="act-btn act-btn--w3 {{item.isOpen ? 'is-on' : ''}}"
                    wx:for="{{workActions}}"
                    wx:key="key"
                    data-type="{{item.key}}"
                    bindtap="handleWorkTap"
                >
                    <text class="act-label">{{item.displayLabel}}</text>
                </view>
                <view
                    class="act-btn act-btn--w2 act-btn--soft {{status.toilet_out ? 'is-on' : ''}}"
                    bindtap="handleToilet"
                >
                    <text class="act-label">{{toiletBtnLabel}}</text>
                </view>
                <view
                    class="act-btn act-btn--w2 act-btn--soft {{status.meeting_out ? 'is-on' : ''}}"
                    bindtap="handleMeeting"
                >
                    <text class="act-label">{{meetingBtnLabel}}</text>
                </view>
            </view>
        </view>

        <view class="act-group act-group--life">
            <view class="act-grid">
                <view
                    class="act-btn {{item.isOpen ? 'is-on' : ''}}"
                    wx:for="{{mealActions}}"
                    wx:key="key"
                    data-type="{{item.key}}"
                    bindtap="handleMealTap"
                >
                    <text class="act-label">{{item.displayLabel}}</text>
                </view>
                <view
                    class="act-btn {{item.isOpen ? 'is-on' : ''}}"
                    wx:for="{{sleepActions}}"
                    wx:key="key"
                    data-type="{{item.key}}"
                    bindtap="handleSleepTap"
                >
                    <text class="act-label">{{item.displayLabel}}</text>
                </view>
                <view
                    class="act-btn {{item.isOpen ? 'is-on' : ''}}"
                    wx:for="{{transportActions}}"
                    wx:key="key"
                    data-type="{{item.key}}"
                    bindtap="handleTransportTap"
                >
                    <text class="act-label">{{item.displayLabel}}</text>
                </view>
            </view>
        </view>

        <view class="act-group act-group--more">
            <view class="act-grid">
                <view
                    class="act-btn {{item.isOpen ? 'is-on' : ''}}"
                    wx:for="{{dailyActions}}"
                    wx:key="key"
                    data-type="{{item.key}}"
                    bindtap="handleActivityTap"
                >
                    <text class="act-label">{{item.displayLabel}}</text>
                </view>
                <view
                    class="act-btn {{item.isOpen ? 'is-on' : ''}}"
                    wx:for="{{sportActions}}"
                    wx:key="key"
                    data-type="{{item.key}}"
                    bindtap="handleActivityTap"
                >
                    <text class="act-label">{{item.displayLabel}}</text>
                </view>
                <view
                    class="act-btn"
                    wx:if="{{!status.custom_open}}"
                    bindtap="handleShowCustomInput"
                >
                    <text class="act-label">自定义</text>
                </view>
                <view
                    class="act-btn is-on"
                    wx:if="{{status.custom_open}}"
                    bindtap="handleCustomEndOpen"
                >
                    <text class="act-label">结束{{customOpenLabel}}</text>
                </view>
            </view>
        </view>
    </view>

    <view class="customs" wx:if="{{affiliation && customActions.length}}">
        <view class="custom-list">
            <view
                class="custom-chip {{item.isOpen ? 'is-on' : ''}}"
                wx:for="{{customActions}}"
                wx:key="label"
                data-label="{{item.label}}"
                bindtap="handleCustomTap"
            >{{item.displayLabel}}</view>
        </view>
    </view>

    <view class="custom-panel" wx:if="{{showCustomInput}}">
        <input
            class="custom-input"
            maxlength="32"
            placeholder="例如：看医生、开会"
            value="{{customLabel}}"
            bindinput="handleCustomInput"
            focus="{{showCustomInput}}"
        />
        <view class="custom-ops">
            <text class="custom-cancel" bindtap="handleHideCustomInput">取消</text>
            <text class="custom-ok" bindtap="handleCustomStart">开始</text>
        </view>
    </view>

    <view class="undo" wx:if="{{eventCount > 0}}" bindtap="handleUndo">撤销上一条</view>

    <view class="seg-panel" wx:if="{{segments.length}}">
        <view class="section-title">今日片段</view>
        <view class="seg-row" wx:for="{{segments}}" wx:key="start_time">
            <text class="seg-time">{{item.start_clock}} - {{item.end_clock}}</text>
            <text class="seg-name">{{item.name}}</text>
            <text class="seg-dur">{{item.text}}</text>
        </view>
    </view>

    <view class="log" wx:if="{{events.length}}">
        <view class="section-title section-title--link" bindtap="handleToggleEventLog">
            {{showEventLog ? '收起事件点' : '展开事件点'}}
        </view>
        <block wx:if="{{showEventLog}}">
            <view class="log-row" wx:for="{{events}}" wx:key="id">
                <text class="log-time">{{item.time}}</text>
                <text class="log-label">{{item.displayLabel || item.label}}</text>
            </view>
        </block>
    </view>

    <view class="empty-card" wx:if="{{affiliation && !loading && !segments.length}}">
        <view class="empty-title">暂无片段</view>
        <view class="empty-desc">点上面的按钮开始记录今天</view>
    </view>

    <mx-safe-area />
</view>

<view class="detail-mask" wx:if="{{showDetailModal}}" catchtouchmove="true" bindtap="handleCloseDetailModal">
    <view class="detail-modal" catchtap="noop">
        <view class="detail-modal-head">
            <text class="detail-modal-title">{{detailModalTitle}}</text>
            <text class="detail-modal-close" bindtap="handleCloseDetailModal">关闭</text>
        </view>
        <scroll-view class="detail-modal-body" scroll-y>
            <view class="detail-line" wx:for="{{detailModalLines}}" wx:key="key">
                <view class="detail-line-main">
                    <text class="detail-line-name">{{item.name}}</text>
                    <text class="detail-line-range" wx:if="{{item.range}}">{{item.range}}</text>
                </view>
                <text class="detail-line-val">{{item.text}}</text>
            </view>
            <view class="detail-empty" wx:if="{{!detailModalLines.length}}">暂无明细</view>
        </scroll-view>
    </view>
</view>

<debug-panel />
