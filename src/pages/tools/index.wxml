<mx-nav theme="light" title="工具" />

<view class="tools-page">
    <view class="tool-grid">
        <view
            class="tool-card tool-card--{{index}}"
            hover-class="tool-card--hover"
            wx:for="{{entries}}"
            wx:key="path"
            data-path="{{item.path}}"
            bindtap="handleEntry"
        >
            <view class="tool-orbit tool-orbit--one"></view>
            <view class="tool-orbit tool-orbit--two"></view>
            <view class="tool-card-head">
                <view class="tool-eyebrow">{{item.eyebrow}}</view>
                <view class="tool-go">↗</view>
            </view>
            <view class="tool-mark">{{item.mark}}</view>
            <view class="tool-content">
                <view class="tool-title">{{item.title}}</view>
                <view class="tool-desc">{{item.desc}}</view>
            </view>
        </view>
    </view>
</view>

<mx-menu options="{{menus}}" current="{{1}}" selectColor="#292B2F" />
<debug-panel />
