<mx-nav theme="light" title="{{config.title}}" />

<view class="page {{(mode === 'storage' || mode === 'category') && !directResult ? 'page--storage' : ''}}" style="min-height: {{contentHeight}}px;">
    <block wx:if="{{(mode === 'storage' || mode === 'category') && !directResult}}">
        <view class="storage-search">
            <view class="storage-search-box">
                <mx-icon name="search" color="#a0a5ad" size="34" />
                <input
                    class="storage-search-input"
                    type="text"
                    maxlength="50"
                    confirm-type="search"
                    placeholder="{{mode === 'storage' ? '在所选位置中搜索物品' : '在所选分类中搜索物品'}}"
                    value="{{keyword}}"
                    bindinput="handleKeywordInput"
                    bindconfirm="handleSearch"
                />
                <view class="search-clear" wx:if="{{keyword}}" bindtap="handleClearKeyword">
                    <mx-icon name="close_fill" color="#a0a5ad" size="38" />
                </view>
            </view>
            <view class="storage-search-btn" hover-class="search-btn--hover" bindtap="handleSearch">搜索</view>
        </view>

        <view class="storage-columns" style="height: {{storageListHeight}}px;">
            <scroll-view class="storage-sidebar" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
                <view class="storage-sidebar-title">{{mode === 'storage' ? '存放位置' : '物品分类'}}</view>
                <view class="storage-option-loading" wx:if="{{optionsLoading}}">加载中...</view>
                <view
                    class="storage-option {{selectedPrimaryId === item.value ? 'storage-option--active' : ''}}"
                    wx:for="{{primaryOptions}}"
                    wx:key="value"
                    data-value="{{item.value}}"
                    data-label="{{item.label}}"
                    bindtap="handleStoragePrimary"
                >
                    <view class="storage-option-text">{{item.shortLabel}}</view>
                </view>
            </scroll-view>

            <scroll-view
                class="storage-results"
                scroll-y
                enhanced="{{true}}"
                show-scrollbar="{{false}}"
                lower-threshold="80"
                bindscrolltolower="handleLoadMore"
            >
                <view class="storage-levels" wx:if="{{storageLevels.length}}">
                    <view
                        class="storage-level"
                        wx:for="{{storageLevels}}"
                        wx:for-item="levelItem"
                        wx:for-index="levelIndex"
                        wx:key="level"
                    >
                        <view class="storage-level-label">{{levelItem.label}}</view>
                        <scroll-view class="storage-tabs" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
                            <view
                                class="storage-tab {{selectedStoragePath[levelIndex] === tab.value ? 'storage-tab--active' : ''}}"
                                wx:for="{{levelItem.options}}"
                                wx:for-item="tab"
                                wx:key="value"
                                data-level-index="{{levelIndex}}"
                                data-value="{{tab.value}}"
                                data-label="{{tab.label}}"
                                bindtap="handleStorageNode"
                            >{{tab.shortLabel}}</view>
                        </scroll-view>
                    </view>
                </view>
                <view class="storage-results-head">
                    <view class="storage-results-title">{{selectedLabel || '请选择位置'}}</view>
                    <view class="storage-results-count" wx:if="{{searched && !loading}}">{{total}} 件</view>
                </view>
                <view
                    class="storage-item"
                    hover-class="item--hover"
                    wx:for="{{list}}"
                    wx:for-item="row"
                    wx:key="id"
                    data-id="{{row.id}}"
                    bindtap="handleDetail"
                >
                    <image
                        class="storage-item-thumb"
                        wx:if="{{row.photo_urls[0]}}"
                        src="{{row.photo_urls[0]}}"
                        mode="aspectFill"
                    />
                    <view class="storage-item-placeholder" wx:else>物</view>
                    <view class="storage-item-main">
                        <view class="storage-item-name">{{row.name}}</view>
                        <view class="storage-item-meta">
                            <text wx:if="{{mode === 'storage' && row.category_name}}">{{row.category_name}}</text>
                            <text wx:if="{{mode === 'category' && row.storage_name}}">{{row.storage_name}}</text>
                            <text wx:if="{{row.affiliation_name}}"> · {{row.affiliation_name}}</text>
                            <text wx:if="{{row.status_text}}"> · {{row.status_text}}</text>
                        </view>
                    </view>
                    <view class="storage-item-arrow">›</view>
                </view>
                <view class="storage-state" wx:if="{{loading}}">加载中...</view>
                <view
                    class="storage-empty"
                    wx:if="{{!loading && searched && empty}}"
                    style="height: {{storageListHeight - 60 - storageLevels.length * 58}}px;"
                >
                    <mx-empty
                        text=""
                        desc="{{mode === 'storage' ? '该位置暂无物品' : '该分类暂无物品'}}"
                        descColor="#c2c6cd"
                        iconName="empty"
                        iconColor="#c8ccd3"
                        iconSize="{{100}}"
                    />
                </view>
                <view class="storage-state" wx:if="{{loadingMore}}">加载更多...</view>
                <view class="storage-state" wx:if="{{searched && !hasMore && list.length && !loading}}">没有更多了</view>
            </scroll-view>
        </view>
    </block>

    <view class="search" wx:if="{{mode === 'name'}}">
        <view class="search-box">
            <input
                class="search-input"
                type="text"
                maxlength="50"
                confirm-type="search"
                placeholder="{{config.placeholder}}"
                value="{{keyword}}"
                bindinput="handleKeywordInput"
                bindconfirm="handleSearch"
            />
            <view class="search-clear" wx:if="{{keyword}}" bindtap="handleClearKeyword">
                <mx-icon name="close_fill" color="#a0a5ad" size="38" />
            </view>
        </view>
        <view class="search-btn" hover-class="search-btn--hover" bindtap="handleSearch">查询</view>
    </view>

    <view class="owner-panel" wx:if="{{mode === 'owner' && !directResult}}">
        <view class="owner-heading">选择物品归属人</view>
        <view class="owner-subtitle">进入对应的个人物品空间</view>
        <view class="owner-list">
            <view
                class="owner-card owner-card--{{item.tone}} {{selectedId === item.value ? 'owner-card--active' : ''}}"
                hover-class="owner-card--hover"
                wx:for="{{options}}"
                wx:key="value"
                data-value="{{item.value}}"
                data-label="{{item.label}}"
                bindtap="handleOptionTap"
            >
                <view class="owner-avatar">{{item.mark}}</view>
                <view class="owner-main">
                    <view class="owner-name">{{item.label}}的物品</view>
                    <view class="owner-desc">{{item.desc}}</view>
                </view>
                <view class="owner-arrow">›</view>
            </view>
        </view>
    </view>

    <view class="result-condition" wx:if="{{directResult}}">
        <view class="result-condition-label">{{config.conditionLabel}}</view>
        <view class="result-condition-value">{{selectedLabel}}</view>
    </view>

    <block wx:if="{{(mode !== 'storage' && mode !== 'category') || directResult}}">
        <view class="result-meta" wx:if="{{searched && !loading}}">
            <text>{{selectedLabel ? selectedLabel + ' · ' : ''}}共 {{total}} 条</text>
        </view>

        <view class="list" wx:if="{{list.length}}">
            <view
                class="item"
                hover-class="item--hover"
                wx:for="{{list}}"
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="handleDetail"
            >
                <image
                    class="item-thumb"
                    wx:if="{{item.photo_urls[0]}}"
                    src="{{item.photo_urls[0]}}"
                    mode="aspectFill"
                />
                <view class="item-placeholder" wx:else>物</view>
                <view class="item-main">
                    <view class="item-name">{{item.name}}</view>
                    <view class="item-sub">
                        <text wx:if="{{item.category_name}}">{{item.category_name}}</text>
                        <text wx:if="{{item.storage_name}}">{{item.category_name ? ' · ' : ''}}{{item.storage_name}}</text>
                        <text wx:if="{{item.affiliation_name}}"> · {{item.affiliation_name}}</text>
                        <text wx:if="{{item.status_text}}"> · {{item.status_text}}</text>
                    </view>
                </view>
                <view class="item-arrow">›</view>
            </view>
        </view>

        <view
            class="empty-wrap query-result-empty"
            wx:if="{{!loading && searched && empty}}"
            style="height: {{contentHeight - 150}}px;"
        >
            <mx-empty
                text=""
                desc="{{config.empty}}"
                descColor="#c2c6cd"
                iconName="empty"
                iconColor="#c8ccd3"
                iconSize="{{96}}"
            />
        </view>
        <view
            class="name-empty"
            wx:if="{{!searched && !loading && mode === 'name'}}"
            style="height: {{contentHeight - 120}}px;"
        >
            <mx-empty
                text=""
                desc="{{config.intro}}"
                descColor="#c2c6cd"
                iconName="empty"
                iconColor="#c8ccd3"
                iconSize="{{100}}"
            />
        </view>
        <view class="tip tip--center" wx:if="{{loading}}">查询中...</view>
        <view class="tip" wx:if="{{loadingMore}}">加载更多...</view>
        <view class="tip tip--end" wx:if="{{searched && !hasMore && list.length && !loading}}">没有更多了</view>
    </block>

    <mx-safe-area />
</view>
<debug-panel />
