<mx-nav theme="light" title="{{title}}" bgColor="#f5f6f8" />

<view class="form-page" wx:if="{{!loading}}">
    <view class="form-panel">
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="名称"
            required="{{true}}"
            placeholder="请输入药品名称"
            value="{{name}}"
            bind:input_change="onNameChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="分类"
            required="{{true}}"
            placeholder="请选择分类"
            options="{{typeOptions}}"
            rangeKey="label"
            index="{{typeIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onTypeChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="剂型"
            required="{{true}}"
            placeholder="请选择剂型"
            options="{{drugFormOptions}}"
            rangeKey="label"
            index="{{drugFormIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onDrugFormChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="用法"
            required="{{true}}"
            placeholder="请选择用法"
            options="{{useWayOptions}}"
            rangeKey="label"
            index="{{useWayIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onUseWayChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="保存方式"
            required="{{true}}"
            placeholder="请选择保存方式"
            options="{{saveWayOptions}}"
            rangeKey="label"
            index="{{saveWayIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onSaveWayChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="状态"
            required="{{true}}"
            placeholder="请选择状态"
            options="{{statusOptions}}"
            rangeKey="label"
            index="{{statusIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            showLine="{{false}}"
            bind:list_picker_change="onStatusChange"
        />
    </view>

    <view class="form-panel">
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="规格"
            placeholder="选填"
            value="{{spec}}"
            bind:input_change="onSpecChange"
        />
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="用量"
            placeholder="选填"
            value="{{dosage}}"
            bind:input_change="onDosageChange"
        />
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="数量"
            type="number"
            placeholder="选填"
            value="{{num}}"
            bind:input_change="onNumChange"
        />
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="单位"
            placeholder="选填"
            value="{{unit}}"
            bind:input_change="onUnitChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="处方药"
            placeholder="请选择"
            options="{{isRxOptions}}"
            rangeKey="label"
            index="{{isRxIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            showLine="{{false}}"
            bind:list_picker_change="onIsRxChange"
        />
    </view>

    <view class="form-panel">
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="date"
            label="购买日期"
            date="{{buyDate}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onBuyDateChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="date"
            label="过期日期"
            date="{{expireDate}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            showLine="{{false}}"
            bind:list_picker_change="onExpireDateChange"
        />
    </view>

    <view class="form-panel">
        <view class="form-section-title">图片（最多3张）</view>
        <view class="photo-block">
            <view class="photo-grid">
                <view class="photo-item" wx:for="{{photos}}" wx:key="key">
                    <image
                        class="photo-img"
                        src="{{item.url}}"
                        mode="aspectFill"
                        data-index="{{index}}"
                        bindtap="handlePreviewPhoto"
                    />
                    <view class="photo-del" data-index="{{index}}" catchtap="handleRemovePhoto">×</view>
                </view>
                <view
                    class="photo-add"
                    hover-class="photo-add--hover"
                    wx:if="{{photos.length < 3}}"
                    bindtap="handleAddPhoto"
                >
                    <view class="photo-add-plus">+</view>
                    <text>添加图片</text>
                </view>
            </view>
        </view>
    </view>

    <view class="form-panel">
        <mx-textarea
            label="备注"
            placeholder="选填"
            value="{{remark}}"
            bind:textarea_change="onRemarkChange"
        />
    </view>

    <view class="form-foot">
        <mx-btn type="primary" width="686rpx" loading="{{submitting}}" bind:tap="handleSubmit">
            {{isEdit ? '保存' : '提交'}}
        </mx-btn>
        <mx-safe-area />
    </view>
</view>

<view class="form-tip" wx:if="{{loading}}">加载中...</view>
<debug-panel />
