<mx-nav theme="light" title="药品查询" />

<view class="manage-page" style="min-height: {{contentHeight}}px;">
    <view class="manage-search">
        <view class="manage-search-box">
            <mx-icon name="search" color="#a0a5ad" size="34" />
            <input
                class="manage-search-input"
                type="text"
                maxlength="100"
                confirm-type="search"
                placeholder="在所选分类中搜索药品"
                value="{{keyword}}"
                bindinput="handleKeywordInput"
                bindconfirm="handleSearch"
            />
            <view class="manage-search-clear" wx:if="{{keyword}}" bindtap="handleClearKeyword">
                <mx-icon name="close_fill" color="#a0a5ad" size="38" />
            </view>
        </view>
        <view class="manage-search-btn" hover-class="manage-hover" bindtap="handleSearch">搜索</view>
    </view>

    <view class="manage-columns" style="height: {{listHeight}}px;">
        <scroll-view class="manage-sidebar" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="manage-sidebar-title">药品分类</view>
            <view
                class="manage-option {{type === item.value ? 'manage-option--active' : ''}}"
                wx:for="{{typeTabs}}"
                wx:key="value"
                data-value="{{item.value}}"
                data-label="{{item.label}}"
                bindtap="handleTypeTap"
            >{{item.label}}</view>
        </scroll-view>

        <scroll-view
            class="manage-results"
            scroll-y
            enhanced="{{true}}"
            show-scrollbar="{{false}}"
            lower-threshold="80"
            bindscrolltolower="handleLoadMore"
        >
            <view class="manage-results-head">
                <view class="manage-results-title">{{selectedTypeLabel}}</view>
                <view class="manage-results-count" wx:if="{{searched && !loading}}">{{total}} 件</view>
            </view>
            <view
                class="manage-item"
                hover-class="manage-hover"
                wx:for="{{list}}"
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="handleDetail"
            >
                <image
                    class="manage-item-thumb"
                    wx:if="{{item.photo_urls[0]}}"
                    src="{{item.photo_urls[0]}}"
                    mode="aspectFill"
                />
                <view class="manage-item-placeholder" wx:else>药</view>
                <view class="manage-item-main">
                    <view class="manage-item-name">{{item.name}}</view>
                    <view class="manage-item-meta">
                        <text wx:if="{{item.drug_form_text}}">{{item.drug_form_text}}</text>
                        <text wx:if="{{item.status_text}}"> · {{item.status_text}}</text>
                        <text wx:if="{{item.expire_date}}"> · 至{{item.expire_date}}</text>
                    </view>
                    <view
                        class="manage-item-days manage-item-days--{{item.remainingState}}"
                        wx:if="{{item.remainingText}}"
                    >{{item.remainingText}}</view>
                </view>
                <view class="manage-item-arrow">›</view>
            </view>
            <view class="manage-state" wx:if="{{loading}}">加载中...</view>
            <view class="manage-empty" wx:if="{{!loading && searched && empty}}" style="height: {{listHeight - 60}}px;">
                <mx-empty
                    text=""
                    desc="该分类暂无药品"
                    descColor="#c2c6cd"
                    iconName="empty"
                    iconColor="#c8ccd3"
                    iconSize="{{96}}"
                />
            </view>
            <view class="manage-state" wx:if="{{loadingMore}}">加载更多...</view>
            <view class="manage-state" wx:if="{{searched && !hasMore && list.length && !loading}}">没有更多了</view>
        </scroll-view>
    </view>
    <mx-safe-area />
</view>
<debug-panel />
