<mx-nav theme="light" title="{{title}}" />

<view class="page page--with-actions" style="min-height: {{contentHeight}}px;">
    <view class="tip tip--center" wx:if="{{loading}}">加载中...</view>
    <view class="empty-wrap" wx:if="{{!loading && empty}}">
        <mx-empty text="未找到该事项" />
    </view>

    <block wx:if="{{detail && !loading}}">
        <view class="hero">
            <view class="hero-name">{{detail.name}}</view>
            <view class="hero-meta">
                <text wx:if="{{detail.remaining_text}}" class="remain remain--{{remainingClass}}">{{detail.remaining_text}}</text>
                <text wx:if="{{detail.cycle}}"> · {{detail.cycle}}</text>
            </view>
        </view>

        <view class="section" wx:for="{{sections}}" wx:key="key">
            <view class="section-title">{{item.title}}</view>
            <view class="section-rows">
                <view
                    class="row {{row.compact ? 'row--compact' : ''}}"
                    wx:for="{{item.rows}}"
                    wx:for-item="row"
                    wx:key="key"
                >
                    <view class="label label--{{row.label.length}}">{{row.label}}</view>
                    <view class="value {{row.multiline ? 'is-multi' : ''}}">{{row.value}}</view>
                </view>
            </view>
        </view>

        <view class="detail-actions" wx:if="{{canWrite}}">
            <view class="action-row">
                <view
                    class="action-btn action-btn--ghost"
                    hover-class="action-btn--hover"
                    bindtap="handleDelete"
                >删除</view>
                <view
                    class="action-btn action-btn--primary"
                    hover-class="action-btn--hover"
                    bindtap="handleEdit"
                >编辑</view>
            </view>
            <mx-safe-area />
        </view>
    </block>

    <mx-safe-area wx:if="{{!detail || loading || !canWrite}}" />
</view>
<debug-panel />
