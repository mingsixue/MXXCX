<mx-nav theme="light" title="续费提醒" />

<view class="renewal-page" style="min-height: {{contentHeight}}px;">
    <view class="renewal-tabs">
        <view
            class="renewal-tab {{scope === item.value ? 'renewal-tab--active' : ''}}"
            wx:for="{{scopes}}"
            wx:key="value"
            data-value="{{item.value}}"
            data-label="{{item.label}}"
            bindtap="handleScopeTap"
        >{{item.label}}</view>
    </view>

    <view class="renewal-summary">
        <view class="renewal-summary-title">{{selectedScopeLabel}}</view>
        <view class="renewal-summary-count">共 {{total}} 项</view>
    </view>

    <view
        class="renewal-item"
        hover-class="renewal-item--hover"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="handleDetail"
    >
        <view class="renewal-main">
            <view class="renewal-name">{{item.name}}</view>
            <view class="renewal-meta">
                <text wx:if="{{item.cycle}}">{{item.cycle}}</text>
                <text wx:if="{{item.price}}">{{item.cycle ? ' · ' : ''}}¥{{item.price}}</text>
                <text wx:if="{{item.is_renewal_text}}">{{(item.cycle || item.price) ? ' · ' : ''}}续费{{item.is_renewal_text}}</text>
            </view>
            <view class="renewal-date-row">
                <view class="renewal-date">到期：{{item.end_date || item.end_time}}</view>
                <view class="renewal-days renewal-days--{{item.remaining_state}}" wx:if="{{item.remaining_text}}">
                    {{item.remaining_text}}
                </view>
            </view>
        </view>
        <view class="renewal-arrow">›</view>
    </view>

    <view class="renewal-state" wx:if="{{loading}}">加载中...</view>
    <view class="renewal-empty" wx:if="{{!loading && empty}}" style="height: {{contentHeight - 150}}px;">
        <mx-empty
            text=""
            desc="暂无续费事项"
            descColor="#c2c6cd"
            iconName="empty"
            iconColor="#c8ccd3"
            iconSize="{{96}}"
        />
    </view>
    <view class="renewal-state" wx:if="{{loadingMore}}">加载更多...</view>
    <view class="renewal-state" wx:if="{{!hasMore && list.length && !loading}}">没有更多了</view>

    <view class="renewal-fab" wx:if="{{canAdd}}" hover-class="renewal-fab--hover" bindtap="handleAdd">+</view>
    <mx-safe-area />
</view>
<debug-panel />
