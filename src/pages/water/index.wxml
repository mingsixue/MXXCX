<mx-nav theme="light" title="喝水" />

<view class="page" style="min-height: {{contentHeight}}px;">
    <view class="hero" wx:if="{{affiliation}}">
        <view class="cup-wrap">
            <view class="cup-stage" bindtap="handleDrink">
                <view class="aura"></view>
                <view class="aura aura--soft"></view>

                <view class="vessel {{cupSplash ? 'is-splash' : ''}} {{fillPercent >= 100 ? 'is-full' : ''}} {{fillPercent > 0 ? 'has-water' : ''}}">
                    <view class="vessel-rim">
                        <view class="vessel-rim-inner"></view>
                    </view>
                    <view class="vessel-body">
                        <view class="glass-sheen"></view>
                        <view class="glass-edge glass-edge--l"></view>
                        <view class="glass-edge glass-edge--r"></view>

                        <view class="pour" wx:if="{{cupSplash}}">
                            <view class="pour-stream"></view>
                            <view class="pour-splash"></view>
                        </view>

                        <view class="liquid {{fillPercent > 0 ? 'is-on' : ''}}" style="height: {{fillHeight}};">
                            <view class="surf">
                                <view class="surf-wave surf-wave--a"></view>
                                <view class="surf-wave surf-wave--b"></view>
                                <view class="surf-shine"></view>
                            </view>
                            <view class="liquid-fill"></view>
                            <view class="liquid-caustic"></view>
                            <view class="ambient">
                                <view class="ab ab1"></view>
                                <view class="ab ab2"></view>
                                <view class="ab ab3"></view>
                                <view class="ab ab4"></view>
                            </view>
                            <view class="splash-bubbles" wx:if="{{cupSplash}}">
                                <view class="sb sb1"></view>
                                <view class="sb sb2"></view>
                                <view class="sb sb3"></view>
                                <view class="sb sb4"></view>
                                <view class="sb sb5"></view>
                                <view class="sb sb6"></view>
                            </view>
                        </view>

                        <view class="empty-hint" wx:if="{{fillPercent === 0}}">
                            <view class="empty-drop"></view>
                        </view>

                        <view class="pct" wx:if="{{fillPercent > 0}}">{{fillPercent}}%</view>
                    </view>
                    <view class="vessel-foot"></view>
                </view>

                <view class="floor-ripple" wx:if="{{cupSplash}}">
                    <view class="ring ring1"></view>
                    <view class="ring ring2"></view>
                </view>

                <view class="tap-hint">{{fillPercent > 0 ? '点杯子记下一口' : '点杯子开始喝水'}}</view>
            </view>

            <view class="side-rail">
                <view class="side-item" bindtap="handleGoalEdit">
                    <text class="side-kicker">目标</text>
                    <text class="side-value">{{goalMl}}</text>
                    <text class="side-unit">ml</text>
                </view>
                <view class="side-item side-item--stats" bindtap="handleStats">
                    <text class="side-kicker">统计</text>
                    <mx-icon name="statistics" size="34" color="#1A6B8A" />
                </view>
            </view>
        </view>

        <view class="hero-num">
            <text class="hero-value">{{totalMl}}</text>
            <text class="hero-unit">/ {{goalMl}} ml</text>
        </view>
        <view class="hero-bar">
            <view class="hero-bar-fill" style="width: {{fillHeight}};"></view>
        </view>
        <view class="hero-sub">今日已喝 {{times}} 次</view>
    </view>

    <view class="panel" wx:if="{{affiliation}}">
        <view class="panel-label">每口分量</view>
        <view class="amounts">
            <view
                class="chip {{item.on ? 'is-on' : ''}}"
                wx:for="{{amountItems}}"
                wx:key="value"
                data-amount="{{item.value}}"
                bindtap="handleSelectAmount"
            >{{item.value}}ml</view>
            <view
                class="chip {{customMode ? 'is-on' : ''}}"
                bindtap="handleCustomTap"
            >自定义</view>
        </view>

        <view class="custom" wx:if="{{customMode}}">
            <input
                class="custom-input"
                type="number"
                maxlength="4"
                placeholder="输入毫升"
                value="{{customAmount}}"
                bindinput="handleCustomInput"
                focus="{{customMode}}"
            />
            <view class="custom-go" bindtap="handleDrink">确定</view>
        </view>

        <view class="undo" wx:if="{{times > 0}}" bindtap="handleUndo">撤销上一口</view>
    </view>

    <view class="log-panel" wx:if="{{records.length}}">
        <view class="panel-label">今日记录</view>
        <view class="log-row" wx:for="{{records}}" wx:key="id">
            <view class="log-dot"></view>
            <text class="log-time">{{item.time}}</text>
            <text class="log-ml">+{{item.amount_ml}} ml</text>
        </view>
    </view>

    <mx-safe-area />
</view>
<debug-panel />
