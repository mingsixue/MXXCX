<mx-nav theme="light" title="{{title}}" />

<view class="page page--with-actions" style="min-height: {{contentHeight}}px;">
    <view class="tip tip--center" wx:if="{{loading}}">加载中...</view>
    <view class="empty-wrap" wx:if="{{!loading && empty}}">
        <mx-empty text="未找到该待办" />
    </view>

    <block wx:if="{{detail && !loading}}">
        <view class="hero">
            <view class="hero-top">
                <view class="hero-name">{{detail.title}}</view>
                <view
                    class="hero-priority hero-priority--{{priorityClass}}"
                    wx:if="{{detail.priority_text}}"
                >{{detail.priority_text}}</view>
            </view>
            <view class="hero-meta-row">
                <view class="hero-meta">
                    <text wx:if="{{detail.type_text}}">{{detail.type_text}}</text>
                    <text wx:if="{{detail.status_text}}">{{detail.type_text ? ' · ' : ''}}{{detail.status_text}}</text>
                </view>
                <view
                    class="todo-countdown todo-countdown--{{countdownState}}"
                    wx:if="{{countdownText}}"
                >{{countdownText}}</view>
            </view>
        </view>

        <view class="section" wx:for="{{sections}}" wx:key="key">
            <view class="section-title">{{item.title}}</view>
            <view class="section-rows">
                <view
                    class="row {{row.compact ? 'row--compact' : ''}}"
                    wx:for="{{item.rows}}"
                    wx:for-item="row"
                    wx:key="key"
                >
                    <view class="label label--{{row.label.length}}">{{row.label}}</view>
                    <view class="value {{row.multiline ? 'is-multi' : ''}}">{{row.value}}</view>
                </view>
            </view>
        </view>

        <view class="detail-actions" wx:if="{{canWrite}}">
            <view class="action-row">
                <view
                    class="action-btn {{canDone ? 'action-btn--ghost' : 'action-btn--primary'}}"
                    hover-class="action-btn--hover"
                    bindtap="handleEdit"
                >编辑</view>
                <view
                    class="action-btn action-btn--primary"
                    wx:if="{{canDone}}"
                    hover-class="action-btn--hover"
                    bindtap="handleDone"
                >标记完成</view>
            </view>
            <view class="action-del" hover-class="action-del--hover" bindtap="handleDelete">删除</view>
            <mx-safe-area />
        </view>
    </block>

    <mx-safe-area wx:if="{{!detail || loading || !canWrite}}" />
</view>
<debug-panel />
