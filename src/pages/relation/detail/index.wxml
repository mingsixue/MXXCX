<mx-nav theme="light" title="{{title}}" />

<view class="page page--with-actions" style="min-height: {{contentHeight}}px;">
    <view class="tip tip--center" wx:if="{{loading}}">加载中...</view>
    <view class="empty-wrap" wx:if="{{!loading && empty}}">
        <mx-empty text="未找到该人员" />
    </view>

    <block wx:if="{{detail && !loading}}">
        <view class="hero">
            <view class="hero-name">{{detail.name}}</view>
            <view class="hero-meta">
                <text wx:if="{{detail.type_text}}">{{detail.type_text}}</text>
                <text wx:if="{{detail.gender_text}}"> · {{detail.gender_text}}</text>
                <text wx:if="{{detail.age_text}}"> · {{detail.age_text}}</text>
            </view>
            <view class="tags" wx:if="{{tags.length}}">
                <text
                    class="tag"
                    wx:for="{{tags}}"
                    wx:key="name"
                    style="color:{{item.color}};background:{{item.bg}};"
                >{{item.name}}</text>
            </view>
            <view class="photos" wx:if="{{photoUrls.length}}">
                <image
                    class="photo"
                    wx:for="{{photoUrls}}"
                    wx:key="*this"
                    src="{{item}}"
                    mode="aspectFill"
                    data-url="{{item}}"
                    bindtap="handlePreviewPhoto"
                />
            </view>
        </view>

        <view class="section" wx:for="{{sections}}" wx:key="key">
            <view class="section-title">{{item.title}}</view>
            <view class="row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="key">
                <view class="label">{{row.label}}</view>
                <view class="value {{row.multiline ? 'is-multi' : ''}}">{{row.value}}</view>
                <view
                    class="copy-btn"
                    wx:if="{{row.copyable}}"
                    data-value="{{row.value}}"
                    catchtap="handleCopy"
                >
                    <mx-icon name="copy" size="32" color="#9aa0b1" />
                </view>
            </view>
        </view>

        <view class="section" wx:if="{{affiliatedPeople.length}}">
            <view class="section-title">关联人</view>
            <view class="aff-list">
                <view
                    class="aff-chip"
                    wx:for="{{affiliatedPeople}}"
                    wx:key="id"
                    data-id="{{item.id}}"
                    bindtap="handleAffiliated"
                >{{item.name}}</view>
            </view>
        </view>

        <view class="detail-actions" wx:if="{{canWrite}}">
            <mx-btn
                type="primary"
                width="686rpx"
                themeColor="#292b2f"
                bind:tap="handleEdit"
            >编辑</mx-btn>
            <mx-safe-area />
        </view>
    </block>

    <mx-safe-area wx:if="{{!detail || loading || !canWrite}}" />
</view>
<debug-panel />
