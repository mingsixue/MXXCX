<mx-nav theme="light" title="衣服鞋裤" />

<view class="menu-page">
    <view class="menu-list">
        <view
            class="menu-card"
            hover-class="menu-card--hover"
            wx:for="{{entries}}"
            wx:key="path"
            data-path="{{item.path}}"
            bindtap="handleEntry"
        >
            <view class="menu-icon {{item.season ? 'menu-icon--expired' : ''}} {{item.owner ? 'menu-icon--owner' : ''}}">{{item.mark}}</view>
            <view class="menu-main">
                <view class="menu-title">{{item.title}}</view>
                <view class="menu-desc">{{item.desc}}</view>
            </view>
            <view class="menu-arrow">›</view>
        </view>
    </view>
    <mx-safe-area />
</view>
<debug-panel />
