<mx-nav theme="light" title="按归属人查看" />

<view class="expired-page" style="min-height: {{contentHeight}}px;">
    <view class="expired-tabs">
        <view
            class="expired-tab {{scope === item.value ? 'expired-tab--active' : ''}}"
            wx:for="{{scopes}}"
            wx:key="value"
            data-value="{{item.value}}"
            data-label="{{item.label}}"
            bindtap="handleScopeTap"
        >{{item.label}}的衣物</view>
    </view>
    <view class="expired-summary">
        <view class="expired-summary-title">{{selectedScopeLabel}}的衣物</view>
        <view class="expired-summary-count">共 {{total}} 件</view>
    </view>

    <view
        class="expired-item"
        hover-class="expired-item--hover"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="handleDetail"
    >
        <image
            class="expired-thumb"
            wx:if="{{item.photo_urls[0]}}"
            src="{{item.photo_urls[0]}}"
            mode="aspectFill"
        />
        <view class="expired-placeholder" wx:else>衣</view>
        <view class="expired-main">
            <view class="expired-name">{{item.name}}</view>
            <view class="expired-meta">
                <text wx:if="{{item.type_text}}">{{item.type_text}}</text>
                <text wx:if="{{item.season_text}}"> · {{item.season_text}}</text>
                <text wx:if="{{item.status_text}}"> · {{item.status_text}}</text>
            </view>
            <view class="expired-date" wx:if="{{item.location}}">位置：{{item.location}}</view>
        </view>
        <view class="expired-arrow">›</view>
    </view>

    <view class="expired-state" wx:if="{{loading}}">加载中...</view>
    <view class="expired-empty" wx:if="{{!loading && empty}}" style="height: {{contentHeight - 150}}px;">
        <mx-empty
            text=""
            desc="该归属人暂无衣物"
            descColor="#c2c6cd"
            iconName="empty"
            iconColor="#c8ccd3"
            iconSize="{{96}}"
        />
    </view>
    <view class="expired-state" wx:if="{{loadingMore}}">加载更多...</view>
    <view class="expired-state" wx:if="{{!hasMore && list.length && !loading}}">没有更多了</view>
    <mx-safe-area />
</view>
<debug-panel />
