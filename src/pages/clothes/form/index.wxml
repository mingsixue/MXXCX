<mx-nav theme="light" title="{{title}}" bgColor="#f5f6f8" />

<view class="form-page" wx:if="{{!loading}}">
    <view class="form-panel">
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="名称"
            required="{{true}}"
            placeholder="请输入衣物名称"
            value="{{name}}"
            bind:input_change="onNameChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="分类"
            required="{{true}}"
            placeholder="请选择分类"
            options="{{typeOptions}}"
            rangeKey="label"
            index="{{typeIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onTypeChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="季节"
            required="{{true}}"
            options="{{seasonOptions}}"
            rangeKey="label"
            index="{{seasonIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onSeasonChange"
        />
        <mx-list-picker
            wx:if="{{!affiliationLocked}}"
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="归属"
            required="{{true}}"
            options="{{affiliationOptions}}"
            rangeKey="label"
            index="{{affiliationIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onAffiliationChange"
        />
        <mx-input
            wx:if="{{affiliationLocked}}"
            styleType="horizontal"
            leftWidth="{{180}}"
            label="归属"
            value="娟"
            disabled="{{true}}"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="状态"
            options="{{statusOptions}}"
            rangeKey="label"
            index="{{statusIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            bind:list_picker_change="onStatusChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="selector"
            label="适用"
            options="{{applicableOptions}}"
            rangeKey="label"
            index="{{applicableIndex}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            showLine="{{false}}"
            bind:list_picker_change="onApplicableChange"
        />
    </view>

    <view class="form-panel">
        <mx-list-basic
            label="颜色"
            leftWidth="{{180}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            content="{{colorText || '选填'}}"
            contentColor="{{colorText ? '#040A23' : '#9AA0B1'}}"
            bind:list_basic_content="handleOpenColorPopup"
        />
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="位置"
            placeholder="选填"
            value="{{location}}"
            bind:input_change="onLocationChange"
        />
        <mx-list-basic
            label="面料"
            leftWidth="{{180}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            content="{{fabricText || '选填'}}"
            contentColor="{{fabricText ? '#040A23' : '#9AA0B1'}}"
            bind:list_basic_content="handleOpenFabricPopup"
        />
        <mx-list-basic
            label="来源"
            leftWidth="{{180}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            content="{{sourceText || '选填'}}"
            contentColor="{{sourceText ? '#040A23' : '#9AA0B1'}}"
            bind:list_basic_content="handleOpenSourcePopup"
        />
        <mx-input
            styleType="horizontal"
            leftWidth="{{180}}"
            label="购买价格"
            type="digit"
            placeholder="选填"
            value="{{buyPrice}}"
            bind:input_change="onBuyPriceChange"
        />
        <mx-list-picker
            styleType="horizontal"
            leftWidth="{{180}}"
            mode="date"
            label="购买日期"
            date="{{buyDate}}"
            isLeft="{{true}}"
            arrows="{{true}}"
            showLine="{{false}}"
            bind:list_picker_change="onBuyDateChange"
        />
    </view>

    <view class="form-panel">
        <view class="form-section-title">图片（最多3张）</view>
        <view class="photo-block">
            <view class="photo-grid">
                <view class="photo-item" wx:for="{{photos}}" wx:key="key">
                    <image
                        class="photo-img"
                        src="{{item.url}}"
                        mode="aspectFill"
                        data-index="{{index}}"
                        bindtap="handlePreviewPhoto"
                    />
                    <view class="photo-del" data-index="{{index}}" catchtap="handleRemovePhoto">×</view>
                </view>
                <view
                    class="photo-add"
                    hover-class="photo-add--hover"
                    wx:if="{{photos.length < 3}}"
                    bindtap="handleAddPhoto"
                >
                    <view class="photo-add-plus">+</view>
                    <text>添加图片</text>
                </view>
            </view>
        </view>
    </view>

    <view class="form-panel">
        <view class="form-section-title">关联衣物</view>
        <view class="select-block">
            <view class="chip-list" wx:if="{{relatedItems.length}}">
                <view
                    class="chip chip--on chip--removable"
                    wx:for="{{relatedItems}}"
                    wx:key="id"
                    data-id="{{item.id}}"
                    bindtap="handleRemoveRelated"
                >
                    <text>{{item.name}}</text>
                    <text class="chip-x">×</text>
                </view>
            </view>
            <view class="select-empty" wx:else>未关联其他衣物</view>
            <view class="aff-search">
                <input
                    class="aff-input"
                    placeholder="输入名称搜索添加"
                    value="{{relatedKeyword}}"
                    confirm-type="search"
                    bindinput="onRelatedKeywordInput"
                    bindconfirm="handleSearchRelated"
                />
                <view class="aff-clear" wx:if="{{relatedKeyword}}" bindtap="handleClearRelatedKeyword">清除</view>
                <view class="aff-btn" hover-class="aff-btn--hover" bindtap="handleSearchRelated">搜索</view>
            </view>
            <view class="aff-hint" wx:if="{{relatedSearching}}">搜索中...</view>
            <view class="aff-results" wx:if="{{relatedResults.length}}">
                <view
                    class="aff-result"
                    hover-class="aff-result--hover"
                    wx:for="{{relatedResults}}"
                    wx:key="id"
                    data-id="{{item.id}}"
                    data-name="{{item.name}}"
                    data-type="{{item.type_text}}"
                    bindtap="handleAddRelated"
                >
                    <image
                        class="aff-result-thumb"
                        wx:if="{{item.thumb}}"
                        src="{{item.thumb}}"
                        mode="aspectFill"
                        data-id="{{item.id}}"
                        catchtap="handlePreviewRelatedResult"
                    />
                    <view class="aff-result-thumb aff-result-thumb--empty" wx:else>衣</view>
                    <view class="aff-result-main">
                        <text class="aff-result-name">{{item.name}}</text>
                        <text class="aff-result-meta" wx:if="{{item.type_text}}">{{item.type_text}}</text>
                    </view>
                    <text class="aff-result-add">添加</text>
                </view>
            </view>
        </view>
    </view>

    <view class="form-panel">
        <mx-textarea
            label="备注"
            placeholder="选填"
            value="{{remark}}"
            bind:textarea_change="onRemarkChange"
        />
    </view>

    <view class="form-foot">
        <mx-btn type="primary" width="686rpx" loading="{{submitting}}" bind:tap="handleSubmit">
            {{isEdit ? '保存' : '提交'}}
        </mx-btn>
        <mx-safe-area />
    </view>
</view>

<view class="form-tip" wx:if="{{loading}}">加载中...</view>

<mx-dialog-bottom
    visible="{{colorPopupVisible}}"
    height="42vh"
    zIndex="{{1000}}"
    showClose="{{false}}"
    bind:dialog_bottom_close="handleCloseColorPopup"
>
    <view class="enum-popup">
        <view class="enum-popup-hd">
            <view class="enum-popup-title">选择颜色</view>
            <view class="enum-popup-done" hover-class="enum-popup-done--hover" bindtap="handleCloseColorPopup">完成</view>
        </view>
        <scroll-view scroll-y class="enum-popup-body" enhanced show-scrollbar="{{false}}">
            <view class="enum-popup-empty" wx:if="{{!colorOptions.length}}">暂无颜色可选</view>
            <view class="chip-list" wx:else>
                <view
                    class="chip {{item.selected ? 'chip--on' : ''}}"
                    wx:for="{{colorOptions}}"
                    wx:key="name"
                    data-name="{{item.name}}"
                    bindtap="handleToggleColor"
                >
                    <view
                        wx:if="{{item.swatch}}"
                        class="chip-swatch {{item.swatchLight ? 'chip-swatch--light' : ''}}"
                        style="background:{{item.swatch}};"
                    ></view>
                    <text>{{item.name}}</text>
                </view>
            </view>
            <mx-safe-area />
        </scroll-view>
    </view>
</mx-dialog-bottom>

<mx-dialog-bottom
    visible="{{fabricPopupVisible}}"
    height="42vh"
    zIndex="{{1000}}"
    showClose="{{false}}"
    bind:dialog_bottom_close="handleCloseFabricPopup"
>
    <view class="enum-popup">
        <view class="enum-popup-hd">
            <view class="enum-popup-title">选择面料</view>
            <view class="enum-popup-done" hover-class="enum-popup-done--hover" bindtap="handleCloseFabricPopup">完成</view>
        </view>
        <scroll-view scroll-y class="enum-popup-body" enhanced show-scrollbar="{{false}}">
            <view class="enum-popup-empty" wx:if="{{!fabricOptions.length}}">暂无面料可选</view>
            <view class="chip-list" wx:else>
                <view
                    class="chip {{item.selected ? 'chip--on' : ''}}"
                    wx:for="{{fabricOptions}}"
                    wx:key="name"
                    data-name="{{item.name}}"
                    bindtap="handleToggleFabric"
                >{{item.name}}</view>
            </view>
            <mx-safe-area />
        </scroll-view>
    </view>
</mx-dialog-bottom>

<mx-dialog-bottom
    visible="{{sourcePopupVisible}}"
    height="42vh"
    zIndex="{{1000}}"
    showClose="{{false}}"
    bind:dialog_bottom_close="handleCloseSourcePopup"
>
    <view class="enum-popup">
        <view class="enum-popup-hd">
            <view class="enum-popup-title">选择来源</view>
            <view class="enum-popup-done" hover-class="enum-popup-done--hover" bindtap="handleCloseSourcePopup">完成</view>
        </view>
        <scroll-view scroll-y class="enum-popup-body" enhanced show-scrollbar="{{false}}">
            <view class="enum-popup-empty" wx:if="{{!sourceOptions.length}}">暂无来源可选</view>
            <view class="chip-list" wx:else>
                <view
                    class="chip {{item.selected ? 'chip--on' : ''}}"
                    wx:for="{{sourceOptions}}"
                    wx:key="name"
                    data-name="{{item.name}}"
                    bindtap="handleToggleSource"
                >{{item.name}}</view>
            </view>
            <mx-safe-area />
        </scroll-view>
    </view>
</mx-dialog-bottom>

<debug-panel />
