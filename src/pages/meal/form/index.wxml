<mx-nav theme="light" title="{{title}}" bgColor="#f7f3ef" />

<view class="page" wx:if="{{!loading}}">
    <view class="day-banner">{{dayDisplay}}</view>

    <view class="card">
        <view class="chip-list">
            <view
                class="chip {{item.on ? 'chip--on' : ''}}"
                wx:for="{{mealTypeOptions}}"
                wx:key="value"
                data-value="{{item.value}}"
                bindtap="onMealTypeTap"
            >{{item.label}}</view>
        </view>
    </view>

    <view class="card card--photos">
        <view class="photo-grid">
            <view class="photo-item" wx:for="{{photos}}" wx:key="key">
                <image
                    class="photo-img"
                    src="{{item.url}}"
                    mode="aspectFill"
                    data-index="{{index}}"
                    bindtap="handlePreviewPhoto"
                />
                <view class="photo-del" data-index="{{index}}" catchtap="handleRemovePhoto">×</view>
            </view>
            <view
                class="photo-add"
                hover-class="photo-add--hover"
                wx:if="{{photos.length < 9}}"
                bindtap="handleAddPhoto"
            >
                <view class="photo-add-plus">+</view>
            </view>
        </view>
    </view>

    <view class="card card--field">
        <view class="field-label">地点</view>
        <input
            class="field-input"
            placeholder="选填"
            placeholder-class="field-placeholder"
            value="{{location}}"
            maxlength="100"
            bindinput="onLocationInput"
        />
    </view>

    <view class="card card--field">
        <view class="field-label">内容</view>
        <textarea
            class="field-textarea"
            placeholder="选填，记录吃了什么"
            placeholder-class="field-placeholder"
            value="{{content}}"
            maxlength="500"
            auto-height
            bindinput="onContentInput"
        />
        <view class="field-count">{{contentLen}} / 500</view>
    </view>

    <view class="foot">
        <view
            class="save-btn {{submitting ? 'save-btn--loading' : ''}}"
            hover-class="save-btn--hover"
            bindtap="handleSubmit"
        >{{submitting ? '保存中…' : '保存'}}</view>
        <mx-safe-area />
    </view>
</view>

<view class="page-tip" wx:if="{{loading}}">加载中...</view>
<debug-panel />
